<UserControl x:Class="HidWizards.UCR.Views.Dialogs.DeviceManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" Background="#212121" Foreground="#FFFFFF"
             TextElement.Foreground="#FFFFFF" FontFamily="{DynamicResource MaterialDesignFont}"
             PreviewMouseWheel="DeviceManagerWindow_OnPreviewMouseWheel"
             PreviewKeyDown="DeviceManagerWindow_OnPreviewKeyDown">
    <Grid Background="#212121">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#202020">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="4 2 8 2" Padding="8 0" Click="Back_OnClick"
                    Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Back to profiles">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0 0 5 0"/>
                    <TextBlock Text="BACK" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1" Text="Devices" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="18" Background="#212121">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Devices" Foreground="#FFFFFF" Style="{StaticResource MaterialDesignTitleTextBlock}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="WINDOWS DEVICES" Click="OpenWindowsDevices_OnClick" Margin="0 0 6 0"
                        Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Open Windows Device Manager for live hardware removal or driver management"/>
                <Button Content="{Binding DetectionButtonText}" Click="DetectDevice_OnClick"
                        Style="{StaticResource MaterialDesignFlatButton}" ToolTip="Identify an input device by pressing one of its buttons or keys"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0 6 0 12">
            <TextBlock Opacity="0.72" TextWrapping="Wrap"
                       Text="Input devices can be removed from UCR and restored later with Detect Device. Output devices stay registered and can be hidden from normal selection lists."/>
            <TextBlock Text="Provider slot numbers are reconciled internally; Windows hardware removal remains under Windows Devices."
                       Opacity="0.55" TextWrapping="Wrap" Margin="0 2 0 0"/>
            <TextBlock Text="{Binding DetectionStatus}" Margin="0 5 0 0" Foreground="{DynamicResource PrimaryHueMidBrush}"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <ListView x:Name="DeviceList" Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch" Background="#212121" Foreground="#FFFFFF"
                  BorderBrush="#424242" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  KeyboardNavigation.TabNavigation="Continue" IsTabStop="False">
            <ListView.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="MinWidth" Value="8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Width="{TemplateBinding Width}" Background="Transparent">
                                    <Track x:Name="PART_Track"
                                           Orientation="{TemplateBinding Orientation}"
                                           Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}"
                                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                           ViewportSize="{TemplateBinding ViewportSize}"
                                           IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Focusable="False" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinHeight="32">
                                                <Thumb.Style>
                                                    <Style TargetType="{x:Type Thumb}">
                                                        <Setter Property="Background" Value="#747474"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#999999"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter Property="Background" Value="#B0B0B0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                          Focusable="False" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="#212121"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3C3C3C" BorderThickness="0 0 0 1" Padding="8 8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0 0 12 0">
                                <TextBlock Text="{Binding ProviderDeviceName}" Foreground="#FFFFFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProviderDeviceName}"/>
                                <TextBlock Text="{Binding ProviderName}" Foreground="#D0D0D0" FontSize="13" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding IoTypes}" Foreground="#D0D0D0" FontSize="13" Opacity="0.72"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="0 0 12 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanPersist}" Background="#2B2B2B" Foreground="#FFFFFF"
                                         CaretBrush="#FFFFFF" BorderBrush="#555555" materialDesign:HintAssist.Hint="Friendly name"
                                         FontSize="17" FontWeight="SemiBold" Padding="10 5" VerticalContentAlignment="Center"
                                         ToolTip="Tab through device names. Alt+Up / Alt+Down moves this device while keeping focus here."
                                         PreviewKeyDown="AliasTextBox_OnPreviewKeyDown"/>
                                <Button Grid.Column="1" Margin="8 0 0 0" Width="34" Height="32" Padding="0"
                                        IsEnabled="{Binding CanPersist}" Click="OutlineColorButton_OnClick"
                                        Background="#252525" BorderBrush="#505050" BorderThickness="1"
                                        ToolTip="Outline colour — click to choose; Default restores the original device colour">
                                    <Border Width="16" Height="16" CornerRadius="2" Background="{Binding CurrentOutlineBrush}"
                                            BorderBrush="#8A8A8A" BorderThickness="1"/>
                                </Button>
                            </Grid>

                            <CheckBox Grid.Column="2" Content="Hidden" Foreground="#FFFFFF" VerticalAlignment="Center" IsTabStop="False"
                                      IsChecked="{Binding Hidden, Mode=TwoWay}" IsEnabled="{Binding CanHide}">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanHide}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button ToolTip="{Binding RemoveFromUcrToolTip}" Click="RemoveFromUcr_OnClick" Padding="4" IsTabStop="False">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignCardButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRemoveFromUcr}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="Trash" Width="18" Height="18"/>
                                </Button>
                                <Button ToolTip="Remove this exact device instance from Windows (administrator approval required)"
                                        Style="{StaticResource MaterialDesignCardButton}" IsEnabled="{Binding CanRemoveFromWindows}" IsTabStop="False"
                                        Click="RemoveFromWindows_OnClick" Padding="4">
                                    <materialDesign:PackIcon Kind="Usb" Width="18" Height="18"/>
                                </Button>
                                <Button ToolTip="Move up (Alt+Up while editing the name)" Style="{StaticResource MaterialDesignCardButton}" IsEnabled="{Binding CanPersist}" IsTabStop="False" Click="MoveUp_OnClick" Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18"/>
                                </Button>
                                <Button ToolTip="Move down (Alt+Down while editing the name)" Style="{StaticResource MaterialDesignCardButton}" IsEnabled="{Binding CanPersist}" IsTabStop="False" Click="MoveDown_OnClick" Padding="4">
                                    <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <Button Content="SAVE" IsDefault="True" Style="{StaticResource MaterialDesignRaisedButton}" Click="Save_OnClick"/>
            <Button Content="CANCEL" Margin="8 0 0 0" Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel_OnClick"/>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
