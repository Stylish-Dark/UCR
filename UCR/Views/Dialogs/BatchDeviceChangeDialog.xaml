<UserControl x:Class="HidWizards.UCR.Views.Dialogs.BatchDeviceChangeDialog"
             Style="{StaticResource UcrDialogRoot}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
             MinWidth="460">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Replace device" Style="{StaticResource MaterialDesignTitleTextBlock}" FontSize="20"/>
        <TextBlock Grid.Row="1" Margin="0 7 0 16" Opacity="0.72" TextWrapping="Wrap"
                   Text="Replace one device throughout this profile. Compatible bindings are translated; definitely incompatible bindings are cleared rather than silently mis-mapped."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Current device" FontWeight="SemiBold" Margin="0 0 0 5"/>
                <ComboBox ItemsSource="{Binding SourceDevices}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" MinWidth="210">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="1 2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="22" Padding="4 1" CornerRadius="4" Background="#1B1B1B"
                                        BorderBrush="{Binding Visual.AccentBrush}" BorderThickness="1" VerticalAlignment="Center" ToolTip="{Binding Visual.ToolTip}">
                                    <TextBlock Text="{Binding Visual.BadgeText}" Foreground="{Binding Visual.AccentBrush}" FontSize="11.5"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AvailabilityText}" FontSize="12" Opacity="0.62"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="→" FontSize="22" Margin="20 24" VerticalAlignment="Center" Opacity="0.62"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Replacement" FontWeight="SemiBold" Margin="0 0 0 5"/>
                <ComboBox ItemsSource="{Binding TargetDevices}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" MinWidth="210">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="1 2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="22" Padding="4 1" CornerRadius="4" Background="#1B1B1B"
                                        BorderBrush="{Binding Visual.AccentBrush}" BorderThickness="1" VerticalAlignment="Center" ToolTip="{Binding Visual.ToolTip}">
                                    <TextBlock Text="{Binding Visual.BadgeText}" Foreground="{Binding Visual.AccentBrush}" FontSize="11.5"
                                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AvailabilityText}" FontSize="12" Opacity="0.62"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0 12 0 0" Opacity="0.62" TextWrapping="Wrap"
                   Text="Only the selected input/output side is changed. Other device bindings in the profile are untouched."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
            <Button Content="REPLACE" IsDefault="True" IsEnabled="{Binding CanApply}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" CommandParameter="{Binding ViewModel}"/>
            <Button Content="CANCEL" IsCancel="True" Margin="8 0 0 0" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
