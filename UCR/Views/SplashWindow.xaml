<Window x:Class="HidWizards.UCR.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Control Remapper"
        Width="520"
        Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{x:Null}">
    <Border x:Name="RootBorder"
            Background="#212121"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="7"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image Width="58" Height="58" Source="pack://application:,,,/Resources/icon.png" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Universal Control Remapper"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="PhaseText"
                               Text="Starting UCR"
                               Foreground="#AFAFAF"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,14,2,10">
                <TextBlock x:Name="StatusText"
                           Text="Preparing..."
                           Foreground="#F2F2F2"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText"
                           Text="Device providers can take a few seconds to initialize."
                           Foreground="#888888"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ProgressBar x:Name="ProgressIndicator"
                         Grid.Row="2"
                         Height="6"
                         IsIndeterminate="True"
                         Foreground="#777777"
                         Background="#353535"
                         BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
