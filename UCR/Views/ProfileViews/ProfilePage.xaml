<UserControl x:Class="HidWizards.UCR.Views.ProfileViews.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converter="clr-namespace:HidWizards.UCR.Utilities.Converter"
             mc:Ignorable="d"
             x:Name="ProfilePageName"
             Unloaded="BatchMappings_OnUnloaded"
             d:DataContext="{d:DesignData Source=/SampleData/ProfileViewModelSampleData.xaml}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             UseLayoutRounding="True"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="ProfilePage_OnPreviewKeyDown"
             PreviewMouseWheel="ProfilePage_OnPreviewMouseWheel">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="MappingSectionVisibilityConverter"/>
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <Style x:Key="ToolboxChoiceList" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <!-- Own the surface template so MaterialDesign's disabled-state chrome cannot
                     turn these dark toolbox rows into large grey slabs behind modal dialogs. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolboxChoiceItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Margin" Value="0 0 3 5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ChoiceBorder" Padding="7 4" CornerRadius="4" Background="#1B1B1B"
                                    BorderBrush="#3A3A3A" BorderThickness="1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChoiceBorder" Property="Background" Value="#2B2B2B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UcrSidebarIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#DADADA"/>
                <Setter Property="Opacity" Value="0.9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#303030"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.48"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UcrProfileActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#DEDEDE"/>
                <Setter Property="Background" Value="#282828"/>
                <Setter Property="BorderBrush" Value="#3D3D3D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Opacity" Value="0.94"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#343434"/>
                        <Setter Property="BorderBrush" Value="#555555"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.48"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UcrSlimVerticalScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="32">
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="Background" Value="#747474"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#B0B0B0"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="Save" Executed="Save_OnExecuted" CanExecute="Save_OnCanExecute" />
    </UserControl.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="ProfilePageHeader" Grid.Row="0" Height="42" Background="#202020">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Margin="5 2 8 2" Padding="0" Width="38" Height="38"
                    Click="Back_OnClick" Style="{StaticResource UcrNavigationBackButton}" ToolTip="Back to profiles (Alt+Left)">
                <materialDesign:PackIcon Kind="ArrowLeft" Width="23" Height="23"/>
            </Button>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Margin="4 0 12 0" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <Grid x:Name="ProfilePageToolbar" Grid.Row="1">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesignShadowBrush}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="2">
                <Border.Effect>
                    <BlurEffect Radius="6"/>
                </Border.Effect>
            </Border>
            <ToolBarTray Style="{DynamicResource MaterialDesignToolBarTray}" IsEnabled="{Binding Source={x:Reference RootDialog}, Path=IsOpen, Converter={StaticResource InverseBooleanConverter}}">
                <ToolBar ToolBarTray.IsLocked="True" Style="{DynamicResource MaterialDesignToolBar}" ClipToBounds="False">
                    <Button ToolTip="Save" Command="Save">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                    <Button IsEnabled="{Binding CanActivateProfile}" ToolTip="Run only this profile (stops other active profiles first)&#x0a;Ctrl+Enter" Click="ActivateProfile">
                        <materialDesign:PackIcon Kind="Play"/>
                    </Button>
                    <Button IsEnabled="{Binding CanActivateProfile}" ToolTip="Run this profile alongside currently active profiles&#x0a;Ctrl+Shift+Enter" Click="ActivateProfileAlongside">
                        <Grid Width="24" Height="24">
                            <materialDesign:PackIcon Kind="Play" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#FFFFFF"/>
                        </Grid>
                    </Button>
                    <Button IsEnabled="{Binding CanDeactivateProfile}" ToolTip="Stop active profile" Click="DeactivateProfile">
                        <Grid Width="24" Height="24">
                            <Border CornerRadius="12" Background="#4A2020" BorderBrush="#D65C5C" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="#DADADA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileActive}" Value="True">
                                                <Setter Property="Foreground" Value="#FF8B8B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </Grid>

        <materialDesign:DialogHost x:Name="RootDialog" Grid.Row="2" Identifier="{Binding ProfileDialogIdentifier}">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="510" MinWidth="390"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="20 12 20 13"
                        Background="#202020" BorderBrush="#383838" BorderThickness="0 0 0 1">
                    <StackPanel>
                        <TextBlock Text="{Binding Profile.Title}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="White" Margin="0 4 0 1"/>
                        <TextBlock Text="{Binding MappingsList.Count, StringFormat={}{0} mappings}"
                                   FontSize="12" Foreground="#AAAAAA"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="SidebarGrid" Grid.Row="1" Grid.Column="1"
                       Margin="12 10 12 8" Visibility="Collapsed" Panel.ZIndex="2">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="MappingToolboxPanel" Grid.Row="0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="Add mapping" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="FROM" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 0 0 5"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PluginToolbox.InputOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedInput, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         Style="{StaticResource ToolboxChoiceList}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="2" Text="TO" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 3 0 5"/>
                                <ListBox Grid.Row="3" ItemsSource="{Binding PluginToolbox.OutputOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedOutput, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         Style="{StaticResource ToolboxChoiceList}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OutputLabel}" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="4" Text="MODE" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 4 0 5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding PluginToolbox.HasRouteVariants}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox Grid.Row="5" ItemsSource="{Binding PluginToolbox.VariantOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedRoute, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ToolboxChoiceList}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding PluginToolbox.HasRouteVariants}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VariantLabel}" FontWeight="SemiBold" Foreground="#DADADA"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="6" Text="SECTION" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 7 0 5"/>
                                <ComboBox Grid.Row="7" ItemsSource="{Binding MappingSections}"
                                          SelectedItem="{Binding SelectedMappingSection, Mode=TwoWay}"
                                          DisplayMemberPath="Title" Height="32" Padding="7 2"
                                          IsEnabled="{Binding CanEditProfile}"
                                          ToolTip="Choose which local section receives the new mapping. Stop the running profile to edit."
                                          ToolTipService.ShowOnDisabled="True"/>

                                <Button Grid.Row="8" Margin="0 7 0 0" Height="34" Content="ADD" FontSize="14" FontWeight="SemiBold"
                                        Style="{StaticResource MaterialDesignRaisedButton}" IsEnabled="{Binding PluginToolbox.CanAddMapping}" Click="AddMapping_OnClick"/>

                                <StackPanel Grid.Row="9" Margin="2 8 2 0">
                                    <TextBlock Text="{Binding PluginToolbox.SelectedPluginName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PluginToolbox.SelectedPluginDescription}" Margin="0 2 0 0" Opacity="0.55" TextWrapping="Wrap" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </Border>

                    <Border x:Name="MappingFiltersPanel" Grid.Row="1" Margin="0 8 0 0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="16" Height="16" Margin="0 0 7 0" Foreground="{StaticResource MappingTypeFilterBrush}"/>
                                        <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FilterDefinitions.Count, StringFormat={}  {0}}" FontSize="12" Opacity="0.45" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ListBox x:Name="FilterDefinitionList" Margin="8" MaxHeight="150" ItemsSource="{Binding FilterDefinitions}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="FilterDefinitionList_OnSelectionChanged">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <StackPanel Margin="8 18" HorizontalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Filter" Width="20" Height="20" HorizontalAlignment="Center" Opacity="0.28"/>
                                                                <TextBlock Margin="0 6 0 0" Text="No filters defined" FontSize="14" Opacity="0.55" HorizontalAlignment="Center"/>
                                                                <TextBlock Margin="0 2 0 0" Text="Create one with a → Filter mapping." FontSize="12" Opacity="0.38" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 1" ToolTip="{Binding ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="25" Height="25" Margin="2 0 7 0" CornerRadius="4"
                                                    Background="#1C281E" BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="1">
                                                <materialDesign:PackIcon Kind="Filter" Width="13" Height="13"
                                                                         Foreground="{StaticResource MappingTypeFilterBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="#FFFFFF" Opacity="0.9"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ReferenceText}" FontSize="11" Opacity="0.62"
                                                       Margin="6 0 2 0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </Border>

                    <Border x:Name="ProfileDevicesPanel" Grid.Row="2" Margin="0 8 0 0" Background="#202020"
                            BorderBrush="#383838" BorderThickness="1" CornerRadius="4" VerticalAlignment="Top">
                        <Expander x:Name="ProfileDevicesExpander" IsExpanded="True" HorizontalContentAlignment="Stretch"
                                  VerticalAlignment="Top" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="3 0 0 0" Padding="10 7">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Usb" Width="16" Height="16" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                                        <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ScrollViewer x:Name="ProfileDevicesScrollViewer" MaxHeight="340"
                                          VerticalAlignment="Top" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="0 0 2 0"
                                          PreviewMouseWheel="ProfileDevicesScrollViewer_OnPreviewMouseWheel">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource UcrSlimVerticalScrollBar}"/>
                                </ScrollViewer.Resources>
                                <StackPanel VerticalAlignment="Top">
                                    <Grid Margin="8 7 8 2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="INPUT" FontSize="10.5" FontWeight="SemiBold" Opacity="0.68" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button ToolTip="Detect and add input device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="DetectProfileInputDevice_OnClick">
                                                <materialDesign:PackIcon Kind="Radar" Width="15" Height="15"/>
                                            </Button>
                                            <Button ToolTip="Add input device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="AddProfileInputDevice_OnClick">
                                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"/>
                                            </Button>
                                            <Button ToolTip="Remove selected input device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="RemoveProfileInputDevice_OnClick" IsEnabled="{Binding InputDeviceControlViewModel.IsRemoveEnabled}">
                                                <materialDesign:PackIcon Kind="Minus" Width="15" Height="15"/>
                                            </Button>
                                            <Button ToolTip="Configure selected input device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="ManageProfileInputDevice_OnClick" IsEnabled="{Binding InputDeviceControlViewModel.IsConfigurationEnabled}">
                                                <materialDesign:PackIcon Kind="Cog" Width="15" Height="15"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox x:Name="InputProfileDeviceList" Margin="6 0 6 4"
                                             ItemsSource="{Binding InputDeviceControlViewModel.Devices}"
                                             SelectedItem="{Binding InputDeviceControlViewModel.SelectedDeviceConfiguration, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="1 2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Width="20" Height="20" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="{Binding PrimaryToolTip}" Click="PrimaryInputDevice_OnClick">
                                                        <Ellipse Width="8" Height="8" Stroke="#929292" StrokeThickness="1.4">
                                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Fill" Value="{DynamicResource PrimaryHueLightBrush}"/><Setter Property="Stroke" Value="{DynamicResource PrimaryHueLightBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                        </Ellipse>
                                                    </Button>
<ContentControl Grid.Column="1" Content="{Binding Visual}" ContentTemplate="{StaticResource DeviceSymbolTemplate}"
                                                                    Width="44" Height="28" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="6 0 0 0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <CheckBox IsChecked="{Binding ExclusiveMode, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanUseExclusiveMode}" Margin="4 0 3 0"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Exclusive Mode: hide this physical HID controller from games while its profile runs (requires HidHide)">
                                                            <materialDesign:PackIcon Kind="EyeOff" Width="15" Height="15" Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                                                        </CheckBox>
                                                        <CheckBox IsChecked="{Binding BlockUnmappedInputs, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanEditConfiguration}"
                                                              VerticalAlignment="Center" Margin="6 0 2 0"
                                                              ToolTip="Block all unmapped inputs from this device in this profile">
                                                        <materialDesign:PackIcon Kind="ShieldOutline" Width="15" Height="15" Foreground="#FFFFFF"/>
                                                    </CheckBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Margin="9 1 9 5">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InputDeviceControlViewModel.IsDetecting}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding InputDeviceControlViewModel.DetectionStatus}" FontSize="10.5"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Height="2" Margin="0 2 0 0" Minimum="0" Maximum="100"
                                                     Value="{Binding InputDeviceControlViewModel.DetectionProgress, Mode=OneWay}"
                                                     Foreground="{DynamicResource PrimaryHueLightBrush}"/>
                                    </StackPanel>

                                    <Grid Margin="8 3 8 7">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="OUTPUT" FontSize="10.5" FontWeight="SemiBold" Opacity="0.68" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button ToolTip="Add output device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="AddProfileOutputDevice_OnClick">
                                                    <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"/>
                                                </Button>
                                                <Button ToolTip="Remove selected output device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="RemoveProfileOutputDevice_OnClick" IsEnabled="{Binding OutputDeviceControlViewModel.IsRemoveEnabled}">
                                                    <materialDesign:PackIcon Kind="Minus" Width="15" Height="15"/>
                                                </Button>
                                                <Button ToolTip="Configure selected output device" Width="25" Height="25" Padding="3" Style="{StaticResource UcrSidebarIconButton}" Click="ManageProfileOutputDevice_OnClick" IsEnabled="{Binding OutputDeviceControlViewModel.IsConfigurationEnabled}">
                                                    <materialDesign:PackIcon Kind="Cog" Width="15" Height="15"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ListBox Grid.Row="1" x:Name="OutputProfileDeviceList" Margin="-2 2 -2 0"
                                                 ItemsSource="{Binding OutputDeviceControlViewModel.Devices}"
                                                 SelectedItem="{Binding OutputDeviceControlViewModel.SelectedDeviceConfiguration, Mode=TwoWay}"
                                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="1 2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Width="20" Height="20" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="{Binding PrimaryToolTip}" Click="PrimaryOutputDevice_OnClick">
                                                            <Ellipse Width="8" Height="8" Stroke="#929292" StrokeThickness="1.4">
                                                                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Fill" Value="{DynamicResource PrimaryHueLightBrush}"/><Setter Property="Stroke" Value="{DynamicResource PrimaryHueLightBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                            </Ellipse>
                                                        </Button>
<ContentControl Grid.Column="1" Content="{Binding Visual}" ContentTemplate="{StaticResource DeviceSymbolTemplate}"
                                                                    Width="44" Height="28" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="6 0 0 0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </Grid>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="0" Margin="14 8 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="4 0 6 8" Padding="10 7" CornerRadius="4"
                            Background="#242A24" BorderBrush="#4B8B58" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#8FD69C" Margin="0 0 8 0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding EditLockReason}" Foreground="#DCE9DE"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="4 7 6 9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mappings" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MappingsList.Count, StringFormat={}  {0}}"
                                       FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="6 0 0 0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Capture" Height="34" Margin="0 0 7 0"
                                    Click="BatchCapture_OnClick" IsEnabled="{Binding CanEditProfile}"
                                    Style="{StaticResource UcrProfileActionButton}"/>
                            <Button Content="+ Add mapping" Height="34" Margin="0 0 7 0"
                                    Click="WorkspaceAddMapping_OnClick" IsEnabled="{Binding CanEditProfile}"
                                    Style="{StaticResource UcrProfileActionButton}"/>
                            <Button Content="···" Width="36" Height="34" Padding="0"
                                    Click="WorkspaceMore_OnClick" ToolTip="Mapping and group tools"
                                    Style="{StaticResource UcrProfileActionButton}">
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource MaterialDesignContextMenu}">
                                        <MenuItem Header="Add group" Click="AddMappingGroup_OnClick"/>
                                        <MenuItem Header="Paste group" Click="PasteMappingGroup_OnClick"/>
                                        <Separator/>
                                        <MenuItem Header="Assign outputs" Click="BatchAssign_OnClick"/>
                                        <MenuItem Header="Rename mappings" Click="RenameMappings_OnClick"/>
                                        <MenuItem Header="Replace device" Click="BatchDevices_OnClick"/>
                                        <Separator/>
                                        <MenuItem Header="Collapse groups" Click="CollapseAllMappings_OnClick"/>
                                        <MenuItem Header="Expand groups" Click="ExpandAllMappings_OnClick"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="7 0 7 7">
                        <TextBox x:Name="WorkspaceMappingSearch" MinHeight="34" Padding="9 5"
                                 Background="#242424" BorderBrush="#505050"
                                 Foreground="White" FontSize="13"
                                 ToolTip="Filter mappings by name"
                                 TextChanged="WorkspaceSearch_OnTextChanged"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="3" x:Name="MappingSectionsScrollViewer"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" Padding="0 1 0 4"
                                  PreviewMouseWheel="MappingSectionsScrollViewer_OnPreviewMouseWheel">
                        <ItemsControl x:Name="MappingSectionsItemsControl" ItemsSource="{Binding MappingSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4 2 6 9" Background="#1C1C1C" BorderBrush="#343434" BorderThickness="1" CornerRadius="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Padding="9 6" Background="#242424" BorderBrush="#3B3B3B" BorderThickness="0 0 0 1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Width="24" Height="24" Margin="0 0 5 0" Padding="0"
                                                            Background="Transparent" BorderThickness="0" ToolTip="Expand or collapse this section"
                                                            Click="ToggleMappingGroupSection_OnClick">
                                                        <TextBlock FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="▾"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Text" Value="▸"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <CheckBox Grid.Column="1" Margin="0 0 8 0" VerticalAlignment="Center"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                                              ToolTip="Include this group when the profile runs. Stop the running profile to change it."
                                                              ToolTipService.ShowOnDisabled="True">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="FolderOutline"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                            <Setter Property="Kind" Value="ViewList"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Mappings.Count, StringFormat={}  {0}}" Margin="4 0 0 0" FontSize="12" Opacity="0.45" VerticalAlignment="Center"/>
                                                        <Border Margin="8 0 0 0" Padding="5 1" CornerRadius="7" Background="#252525" BorderBrush="#484848" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="ALWAYS" FontSize="8.5" FontWeight="Bold" Opacity="0.65"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <Button Width="27" Height="27" Padding="3" Margin="1 0"
                                                                ToolTip="Rename group" IsEnabled="{Binding CanEdit}" Click="RenameMappingGroup_OnClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource UcrProfileActionButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Width="27" Height="27" Padding="3" Margin="1 0" ToolTip="Duplicate group"
                                                                IsEnabled="{Binding CanEdit}" Click="DuplicateMappingGroup_OnClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource UcrProfileActionButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Width="27" Height="27" Padding="3" Margin="1 0" ToolTip="Copy group" Click="CopyMappingGroup_OnClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource UcrProfileActionButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="ContentDuplicate" Width="15" Height="15"/>
                                                        </Button>
                                                        <Button Width="27" Height="27" Padding="3" Margin="1 0" ToolTip="Delete group"
                                                                IsEnabled="{Binding CanEdit}" Click="RemoveMappingGroup_OnClick">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource UcrProfileActionButton}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsMain}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#FF8B8B"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <ListView Grid.Row="1" ItemsSource="{Binding Mappings}" SelectionChanged="MappingListView_OnSelectionChanged" Margin="0" Padding="0 2 0 3"
                                                      Background="Transparent" BorderThickness="0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource MappingSectionVisibilityConverter}}"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False"
                                                      PreviewMouseRightButtonDown="MappingListView_OnPreviewMouseRightButtonDown"
                                                      PreviewMouseRightButtonUp="MappingListView_OnPreviewMouseRightButtonUp"
                                                      PreviewMouseMove="MappingListView_OnPreviewMouseMove"
                                                      LostMouseCapture="MappingListView_OnLostMouseCapture">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="{x:Type ListViewItem}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.Style>
                                                    <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
                                                        <Style.Triggers>
                                                            <Trigger Property="HasItems" Value="False">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate>
                                                                            <TextBlock Margin="12 10" Text="No mappings in this section." Opacity="0.45" HorizontalAlignment="Center"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListView.Style>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0 3" Padding="12 9" CornerRadius="4"
                                                                Background="#252525" BorderBrush="#393939" BorderThickness="1">
                                                            <Grid MinHeight="50">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="24"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding MappingTitle}" Foreground="White"
                                                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding MappingOutputTypeLabel}" FontSize="11"
                                                                               Foreground="#B0B0B0" Margin="0 3 0 0"/>
                                                                </StackPanel>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding CollapsedInputVisuals}"
                                                                              VerticalAlignment="Center">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <controls:ControlGlyphControl Kind="{Binding ControlKind}"
                                                                                                          AccentBrush="{Binding ControlBrush}"
                                                                                                          Label="{Binding ControlLabel}"
                                                                                                          Width="46" Height="32"
                                                                                                          ToolTip="{Binding ToolTip}" Margin="1 0"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Grid.Column="2" Text="→" Foreground="#AAAAAA"
                                                                           Margin="7 0" FontSize="19" VerticalAlignment="Center"/>
                                                                <ItemsControl Grid.Column="3" ItemsSource="{Binding CollapsedOutputVisuals}"
                                                                              VerticalAlignment="Center">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <controls:ControlGlyphControl Kind="{Binding ControlKind}"
                                                                                                          AccentBrush="{Binding ControlBrush}"
                                                                                                          Label="{Binding ControlLabel}"
                                                                                                          Width="46" Height="32"
                                                                                                          ToolTip="{Binding ToolTip}" Margin="1 0"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Grid.Column="4" Text="›" FontSize="24" Foreground="#AFAFAF"
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            <Grid x:Name="SelectedMappingInspector" Grid.Row="1" Grid.Column="1"
                  Background="#202020" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="18 15" BorderBrush="#363636" BorderThickness="1 0 0 1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SelectedMapping.MappingTitle, TargetNullValue='Select a mapping'}"
                                       FontSize="21" FontWeight="SemiBold" Foreground="White" Margin="0 4 8 0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Width="34" Height="34" Margin="4 0 0 0"
                                    Click="DeleteSelectedMapping_OnClick" IsEnabled="{Binding CanEditProfile}"
                                    ToolTip="Delete selected mapping" Style="{StaticResource UcrProfileActionButton}">
                                <materialDesign:PackIcon Kind="Delete" Width="19" Height="19"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Background="#202020">
                    <ContentControl Content="{Binding SelectedMapping}" HorizontalContentAlignment="Stretch">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <controls:MappingCardControl InspectorMode="True"/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
            </Grid>
        </materialDesign:DialogHost>

        <Grid x:Name="BatchOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
              Background="#DD101010" Visibility="Collapsed">
            <Border Width="460" Padding="22" Background="#242424"
                    BorderBrush="#606060" BorderThickness="1" CornerRadius="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BatchTitle" FontSize="21" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="BatchStatus" Margin="0 16 0 6" FontSize="14"
                               Foreground="#E6E6E6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BatchProgress" Margin="0 0 0 16"
                               FontSize="13" Foreground="#AAAAAA"/>
                    <Button Content="Finish" Width="104" Height="36"
                            HorizontalAlignment="Right" Click="BatchFinish_OnClick"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
