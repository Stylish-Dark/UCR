<Window x:Class="HidWizards.UCR.Views.ProfileViews.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converter="clr-namespace:HidWizards.UCR.Utilities.Converter"
        mc:Ignorable="d"
        x:Name="ProfileWindowName"
        d:DataContext="{d:DesignData Source=/SampleData/ProfileViewModelSampleData.xaml}"
        Title="{Binding Title}"
        Height="800" Width="1000"
        MinHeight="600" MinWidth="800"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        UseLayoutRounding="True"
        PreviewKeyDown="ProfileWindow_OnPreviewKeyDown"
        PreviewMouseWheel="ProfileWindow_OnPreviewMouseWheel">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <Style x:Key="ToolboxChoiceList" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
                <!-- Own the surface template so MaterialDesign's disabled-state chrome cannot
                     turn these dark toolbox rows into large grey slabs behind modal dialogs. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolboxChoiceItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Margin" Value="0 0 5 5"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ChoiceBorder" Padding="8 4" CornerRadius="4" Background="#1B1B1B"
                                    BorderBrush="#3A3A3A" BorderThickness="1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ChoiceBorder" Property="Background" Value="#303030"/>
                                    <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ChoiceBorder" Property="Background" Value="#2B2B2B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="Save_OnExecuted" CanExecute="Save_OnCanExecute" />
    </Window.CommandBindings>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{DynamicResource UcrUiScale}" ScaleY="{DynamicResource UcrUiScale}"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:WindowBar Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesignShadowBrush}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="2">
                <Border.Effect>
                    <BlurEffect Radius="6"/>
                </Border.Effect>
            </Border>
            <ToolBarTray Style="{DynamicResource MaterialDesignToolBarTray}" IsEnabled="{Binding Source={x:Reference RootDialog}, Path=IsOpen, Converter={StaticResource InverseBooleanConverter}}">
                <ToolBar ToolBarTray.IsLocked="True" Style="{DynamicResource MaterialDesignToolBar}" ClipToBounds="False">
                    <Button ToolTip="Save" Command="Save">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                    <Button IsEnabled="{Binding CanActivateProfile}" ToolTip="Activate profile" Click="ActivateProfile">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Play"/>
                            <materialDesign:PackIcon Kind="Replay" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding CanDeactivateProfile}" ToolTip="Stop active profile" Click="DeactivateProfile">
                        <materialDesign:PackIcon Kind="Stop"/>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </Grid>

        <materialDesign:DialogHost x:Name="RootDialog" Grid.Row="2" Identifier="{Binding ProfileDialogIdentifier}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="SidebarGrid" Grid.Column="0" Margin="0 0 10 0">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="17" Height="17" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="Add mapping" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="FROM" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 0 0 5"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PluginToolbox.InputOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedInput, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         Style="{StaticResource ToolboxChoiceList}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                                       Foreground="{Binding Converter={StaticResource MappingTypeBrushConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="2" Text="TO" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 3 0 5"/>
                                <ListBox Grid.Row="3" ItemsSource="{Binding PluginToolbox.OutputOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedOutput, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         Style="{StaticResource ToolboxChoiceList}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OutputLabel}" FontWeight="SemiBold"
                                                       Foreground="{Binding OutputLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="4" Text="MODE" FontSize="10.5" FontWeight="SemiBold" Opacity="0.48" Margin="2 4 0 5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding PluginToolbox.HasRouteVariants}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ListBox Grid.Row="5" ItemsSource="{Binding PluginToolbox.VariantOptions}"
                                         SelectedItem="{Binding PluginToolbox.SelectedRoute, Mode=TwoWay}"
                                         IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                         ItemContainerStyle="{StaticResource ToolboxChoiceItem}">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ToolboxChoiceList}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding PluginToolbox.HasRouteVariants}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VariantLabel}" FontWeight="SemiBold" Foreground="#DADADA"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Row="6" Margin="0 6 0 0" Height="34" Content="ADD" FontSize="14" FontWeight="SemiBold"
                                        Style="{StaticResource MaterialDesignRaisedButton}" IsEnabled="{Binding PluginToolbox.CanAddMapping}" Click="AddMapping_OnClick"/>

                                <StackPanel Grid.Row="7" Margin="2 8 2 0">
                                    <TextBlock Text="{Binding PluginToolbox.SelectedPluginName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PluginToolbox.SelectedPluginDescription}" Margin="0 2 0 0" Opacity="0.55" TextWrapping="Wrap" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                    </Border>

                    <Border Grid.Row="1" Margin="0 8 0 0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="16" Height="16" Margin="0 0 7 0" Foreground="{StaticResource MappingTypeFilterBrush}"/>
                                        <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FilterDefinitions.Count, StringFormat={}  {0}}" FontSize="12" Opacity="0.45" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ListBox x:Name="FilterDefinitionList" Margin="8" MaxHeight="150" ItemsSource="{Binding FilterDefinitions}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="FilterDefinitionList_OnSelectionChanged">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <StackPanel Margin="8 18" HorizontalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Filter" Width="20" Height="20" HorizontalAlignment="Center" Opacity="0.28"/>
                                                                <TextBlock Margin="0 6 0 0" Text="No filters defined" FontSize="14" Opacity="0.55" HorizontalAlignment="Center"/>
                                                                <TextBlock Margin="0 2 0 0" Text="Create one with a → Filter mapping." FontSize="12" Opacity="0.38" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0 1" ToolTip="{Binding ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="25" Height="25" Margin="2 0 7 0" CornerRadius="4"
                                                    Background="#1C281E" BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="1">
                                                <materialDesign:PackIcon Kind="Filter" Width="13" Height="13"
                                                                         Foreground="{StaticResource MappingTypeFilterBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding KindText}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MappingTypeFilterBrush}" Opacity="0.72"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ReferenceText}" FontSize="11" Opacity="0.48"
                                                       Margin="8 0 2 0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </Border>

                    <Border Grid.Row="2" Margin="0 8 0 0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#202020">
                            <Expander.Header>
                                <Border Background="#242424" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="3 0 0 0" Padding="10 7">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Usb" Width="16" Height="16" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="Devices" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                            <Grid Margin="8 7 8 2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="INPUT" FontSize="10.5" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button ToolTip="Detect and add input device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="DetectProfileInputDevice_OnClick">
                                        <materialDesign:PackIcon Kind="Radar" Width="15" Height="15"/>
                                    </Button>
                                    <Button ToolTip="Add input device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="AddProfileInputDevice_OnClick">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"/>
                                    </Button>
                                    <Button ToolTip="Remove selected input device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="RemoveProfileInputDevice_OnClick" IsEnabled="{Binding InputDeviceControlViewModel.IsRemoveEnabled}">
                                        <materialDesign:PackIcon Kind="Minus" Width="15" Height="15"/>
                                    </Button>
                                    <Button ToolTip="Configure selected input device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="ManageProfileInputDevice_OnClick" IsEnabled="{Binding InputDeviceControlViewModel.IsConfigurationEnabled}">
                                        <materialDesign:PackIcon Kind="Cog" Width="15" Height="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="InputProfileDeviceList" Margin="6 0 6 4"
                                     ItemsSource="{Binding InputDeviceControlViewModel.Devices}"
                                     SelectedItem="{Binding InputDeviceControlViewModel.SelectedDeviceConfiguration, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="1 2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Width="20" Height="20" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="{Binding PrimaryToolTip}" Click="PrimaryInputDevice_OnClick">
                                                <Ellipse Width="8" Height="8" Stroke="#777" StrokeThickness="1.4">
                                                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/><Setter Property="Stroke" Value="{DynamicResource PrimaryHueMidBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                </Ellipse>
                                            </Button>
                                            <Border Grid.Column="1" Width="32" Height="21" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Visual.OutlineBrush}" Background="#191919">
                                                <TextBlock Text="{Binding Visual.BadgeText}" Foreground="{Binding Visual.AccentBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="6 0 0 0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="9 1 9 5">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InputDeviceControlViewModel.IsDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding InputDeviceControlViewModel.DetectionStatus}" FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="2" Margin="0 2 0 0" Minimum="0" Maximum="100"
                                             Value="{Binding InputDeviceControlViewModel.DetectionProgress, Mode=OneWay}"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                            <Grid Grid.Row="3" Margin="8 3 8 7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="OUTPUT" FontSize="10.5" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button ToolTip="Add output device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="AddProfileOutputDevice_OnClick">
                                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"/>
                                        </Button>
                                        <Button ToolTip="Remove selected output device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="RemoveProfileOutputDevice_OnClick" IsEnabled="{Binding OutputDeviceControlViewModel.IsRemoveEnabled}">
                                            <materialDesign:PackIcon Kind="Minus" Width="15" Height="15"/>
                                        </Button>
                                        <Button ToolTip="Configure selected output device" Width="25" Height="25" Padding="3" Style="{StaticResource MaterialDesignFlatButton}" Click="ManageProfileOutputDevice_OnClick" IsEnabled="{Binding OutputDeviceControlViewModel.IsConfigurationEnabled}">
                                            <materialDesign:PackIcon Kind="Cog" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ListBox Grid.Row="1" x:Name="OutputProfileDeviceList" Margin="-2 2 -2 0"
                                         ItemsSource="{Binding OutputDeviceControlViewModel.Devices}"
                                         SelectedItem="{Binding OutputDeviceControlViewModel.SelectedDeviceConfiguration, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1 2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Width="20" Height="20" Padding="4" Background="Transparent" BorderThickness="0" ToolTip="{Binding PrimaryToolTip}" Click="PrimaryOutputDevice_OnClick">
                                                    <Ellipse Width="8" Height="8" Stroke="#777" StrokeThickness="1.4">
                                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsPrimary}" Value="True"><Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/><Setter Property="Stroke" Value="{DynamicResource PrimaryHueMidBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                                    </Ellipse>
                                                </Button>
                                                <Border Grid.Column="1" Width="32" Height="21" CornerRadius="4" BorderThickness="1" BorderBrush="{Binding Visual.OutlineBrush}" Background="#191919">
                                                    <TextBlock Text="{Binding Visual.BadgeText}" Foreground="{Binding Visual.AccentBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="6 0 0 0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            </Grid>
                        </Expander>
                    </Border>
                </Grid>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4 0 6 7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mappings" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MappingsList.Count, StringFormat={}  {0}}" FontSize="13" Opacity="0.45" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Margin="6 0 2 0" Padding="9 2" Height="30"
                                ToolTip="Rename mappings in one pass" IsEnabled="{Binding CanEditProfile}"
                                Style="{StaticResource MaterialDesignFlatButton}" Click="RenameMappings_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rename mappings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Margin="6 0 2 0" Padding="9 2" Height="30"
                                ToolTip="Replace one device throughout this profile" IsEnabled="{Binding CanEditProfile}"
                                Style="{StaticResource MaterialDesignFlatButton}" Click="BatchDevices_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↔" FontSize="16" Margin="0 0 6 0" VerticalAlignment="Center" Opacity="0.82"/>
                                <TextBlock Text="Replace device" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Margin="5 0 1 0" Padding="4" Width="28" Height="28"
                                ToolTip="Collapse all mappings" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="CollapseAllMappings_OnClick">
                            <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                        </Button>

                        <Button Grid.Column="4" Margin="1 0 0 0" Padding="4" Width="28" Height="28"
                                ToolTip="Expand all mappings" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="ExpandAllMappings_OnClick">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1"
                          x:Name="MappingListView"
                          ItemsSource="{Binding MappingsList}"
                          Margin="0"
                          Padding="0 1 0 4"
                          Background="Transparent"
                          BorderThickness="0"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          VirtualizingPanel.IsVirtualizing="False"
                          PreviewMouseRightButtonDown="MappingListView_OnPreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="MappingListView_OnPreviewMouseRightButtonUp"
                          PreviewMouseMove="MappingListView_OnPreviewMouseMove"
                          LostMouseCapture="MappingListView_OnLostMouseCapture">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Style>
                        <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="LibraryAdd" Width="30" Height="30" HorizontalAlignment="Center" Opacity="0.4"/>
                                                    <TextBlock Margin="4 10 4 0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">No mappings yet</TextBlock>
                                                    <TextBlock Margin="4" Opacity="0.62" HorizontalAlignment="Center">Choose a route on the left, then click ADD.</TextBlock>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:MappingCardControl/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
