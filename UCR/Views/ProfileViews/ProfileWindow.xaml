<Window x:Class="HidWizards.UCR.Views.ProfileViews.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converter="clr-namespace:HidWizards.UCR.Utilities.Converter"
        mc:Ignorable="d"
        x:Name="ProfileWindowName"
        d:DataContext="{d:DesignData Source=/SampleData/ProfileViewModelSampleData.xaml}"
        Title="{Binding Title}"
        Height="800" Width="1000"
        MinHeight="600" MinWidth="800"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource PrimaryHueDarkBrush}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Save" Executed="Save_OnExecuted" CanExecute="Save_OnCanExecute" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:WindowBar Grid.Row="0"/>
        <Grid Grid.Row="1">
            <Border Background="Transparent"
                    BorderBrush="{DynamicResource MaterialDesignShadowBrush}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="2">
                <Border.Effect>
                    <BlurEffect Radius="6"/>
                </Border.Effect>
            </Border>
            <ToolBarTray Style="{DynamicResource MaterialDesignToolBarTray}" IsEnabled="{Binding Source={x:Reference RootDialog}, Path=IsOpen, Converter={StaticResource InverseBooleanConverter}}">
                <ToolBar ToolBarTray.IsLocked="True" Style="{DynamicResource MaterialDesignToolBar}" ClipToBounds="False">
                    <Button ToolTip="Save" Command="Save">
                        <materialDesign:PackIcon Kind="ContentSave"/>
                    </Button>
                    <Button IsEnabled="{Binding CanActivateProfile}" ToolTip="Activate profile" Click="ActivateProfile">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="Play"/>
                            <materialDesign:PackIcon Kind="Replay" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="{Binding CanDeactivateProfile}" ToolTip="Stop active profile" Click="DeactivateProfile">
                        <materialDesign:PackIcon Kind="Stop"/>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </Grid>

        <materialDesign:DialogHost x:Name="RootDialog" Grid.Row="2" Identifier="{Binding ProfileDialogIdentifier}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0 0 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#242424" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="17" Height="17" Margin="0 0 7 0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <TextBlock Text="Add mapping" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding PluginToolbox.InputOptions}"
                                              SelectedItem="{Binding PluginToolbox.SelectedInput, Mode=TwoWay}"
                                              IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                              MinWidth="100" ToolTip="Input type">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                                           Foreground="{Binding Converter={StaticResource MappingTypeBrushConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="1" Text="→" Margin="7 0" VerticalAlignment="Center" FontSize="16" Opacity="0.55"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding PluginToolbox.OutputOptions}"
                                              SelectedItem="{Binding PluginToolbox.SelectedRoute, Mode=TwoWay}"
                                              IsEnabled="{Binding PluginToolbox.IsEnabled}"
                                              MinWidth="100" ToolTip="Output type">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OutputDisplayLabel}" FontWeight="SemiBold"
                                                           Foreground="{Binding OutputLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Button Grid.Row="1" Margin="0 9 0 0" Height="34" Content="ADD" FontSize="14" FontWeight="SemiBold"
                                        Style="{StaticResource MaterialDesignRaisedButton}" IsEnabled="{Binding PluginToolbox.CanAddMapping}" Click="AddMapping_OnClick"/>

                                <StackPanel Grid.Row="2" Margin="2 8 2 0">
                                    <TextBlock Text="{Binding PluginToolbox.SelectedRoute.PluginItem.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PluginToolbox.SelectedRoute.PluginItem.Description}" Margin="0 2 0 0" Opacity="0.55" TextWrapping="Wrap" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0 8 0 0" Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#242424" BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="3 0 0 0" Padding="10 8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Filter" Width="16" Height="16" Margin="0 0 7 0" Foreground="{StaticResource MappingTypeFilterBrush}"/>
                                    <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FilterNames.Count, StringFormat={}  {0}}" FontSize="12" Opacity="0.45" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ListBox Grid.Row="1" Margin="8" ItemsSource="{Binding FilterNames}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <StackPanel Margin="8 18" HorizontalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Filter" Width="20" Height="20" HorizontalAlignment="Center" Opacity="0.28"/>
                                                                <TextBlock Margin="0 6 0 0" Text="No filters defined" FontSize="14" Opacity="0.55" HorizontalAlignment="Center"/>
                                                                <TextBlock Margin="0 2 0 0" Text="Create one with a → Filter mapping." FontSize="12" Opacity="0.38" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#343434" BorderThickness="0 0 0 1" Padding="7 7">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Filter" Width="14" Height="14" Margin="0 0 7 0" Foreground="{StaticResource MappingTypeFilterBrush}"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="4 0 6 7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mappings" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MappingsList.Count, StringFormat={}  {0}}" FontSize="13" Opacity="0.45" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" Margin="6 0 2 0" Padding="9 2" Height="30"
                                ToolTip="Rename mappings in one pass" IsEnabled="{Binding CanEditProfile}"
                                Style="{StaticResource MaterialDesignFlatButton}" Click="RenameMappings_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Margin="0 0 6 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rename mappings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Margin="6 0 2 0" Padding="9 2" Height="30"
                                ToolTip="Replace one device throughout this profile" IsEnabled="{Binding CanEditProfile}"
                                Style="{StaticResource MaterialDesignFlatButton}" Click="BatchDevices_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↔" FontSize="16" Margin="0 0 6 0" VerticalAlignment="Center" Opacity="0.82"/>
                                <TextBlock Text="Replace device" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Margin="5 0 0 0" Padding="6 2" Width="30" Height="30"
                                ToolTip="Mapping view options" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="ContextMenuButton_OnClick">
                            <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18"/>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MaterialDesignContextMenu}">
                                    <MenuItem Header="Collapse all mappings" Click="CollapseAllMappings_OnClick"/>
                                    <MenuItem Header="Expand all mappings" Click="ExpandAllMappings_OnClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1"
                          x:Name="MappingListView"
                          ItemsSource="{Binding MappingsList}"
                          Margin="0"
                          Padding="0 1 0 4"
                          Background="Transparent"
                          BorderThickness="0"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          AllowDrop="True"
                          PreviewMouseRightButtonDown="MappingListView_OnPreviewMouseRightButtonDown"
                          PreviewMouseRightButtonUp="MappingListView_OnPreviewMouseRightButtonUp"
                          PreviewMouseMove="MappingListView_OnPreviewMouseMove"
                          DragOver="MappingListView_OnDragOver"
                          Drop="MappingListView_OnDrop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Style>
                        <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="LibraryAdd" Width="30" Height="30" HorizontalAlignment="Center" Opacity="0.4"/>
                                                    <TextBlock Margin="4 10 4 0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center">No mappings yet</TextBlock>
                                                    <TextBlock Margin="4" Opacity="0.62" HorizontalAlignment="Center">Choose a route on the left, then click ADD.</TextBlock>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:MappingCardControl/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</Window>
