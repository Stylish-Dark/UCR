<UserControl x:Class="HidWizards.UCR.Views.Controls.CompactInputBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             UseLayoutRounding="True"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <Style x:Key="CompactBlockSwitch" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#515151"/>
            <Setter Property="BorderBrush" Value="#737373"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3 0 0 0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#F2F2F2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactBindSurfaceButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3 0 0 3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CompactBindOptionsButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#EAEAEA"/>
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0 3 3 0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#414141"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The generated output-picker tabs cannot inherit the light WPF
             selected-tab chrome: it made white captions disappear on white. -->
        <Style x:Key="OutputPickerTabStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#D2D2D2"/>
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Padding" Value="13 7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4C4C4C"
                                BorderThickness="1 1 1 0"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="TabChrome" Property="Background" Value="#343434"/>
                                <Setter TargetName="TabChrome" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="BindingGrid" MinHeight="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Match the actual selector width (58px normal, 44px compact).
                 Reserving 62px even in compact mode starves paired Bind buttons. -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="42"/>
            <!-- Auto collapses to zero for outputs, where Block is hidden.
                 A fixed 92px column previously stole space from Choose output. -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- The CLOSED selector and the OPEN list deliberately have different layouts.
             The selected icon is rendered separately, so no long device label can clip it. -->
        <ComboBox Grid.Row="0" Grid.Column="0" x:Name="DeviceSelectionBox"
                  Height="38" Margin="0 0 4 0" Padding="0"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                  IsEnabled="{Binding BindingEnabled}"
                  DropDownOpened="DeviceSelectionBox_OnDropDownOpened"
                  SelectionChanged="DeviceSelectionBox_OnSelectionChanged"
                  ToolTip="{Binding SelectedDevice.Title}">
            <ComboBox.Style>
                <Style TargetType="{x:Type ComboBox}">
                    <Setter Property="Width" Value="58"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactDirectional, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="Width" Value="44"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
            <ComboBox.Template>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="DeviceSurface" CornerRadius="3" Background="#292929"
                                BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>
                                <local:DeviceSymbolControl x:Name="ClosedDeviceGlyph"
                                    Grid.Column="0" IsHitTestVisible="False"
                                    SymbolText="{Binding SelectedItem.Visual.SymbolText, RelativeSource={RelativeSource TemplatedParent}}"
                                    Foreground="{Binding SelectedItem.Visual.BadgeTextBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                    Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:DeviceSymbolControl.Style>
                                        <Style TargetType="{x:Type local:DeviceSymbolControl}">
                                            <Setter Property="GlyphSize" Value="31"/>
                                            <Setter Property="Width" Value="33"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CompactDirectional, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                                                    <Setter Property="GlyphSize" Value="25"/>
                                                    <Setter Property="Width" Value="26"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:DeviceSymbolControl.Style>
                                </local:DeviceSymbolControl>
                                <materialDesign:PackIcon Grid.Column="1" Kind="ChevronDown"
                                    Width="13" Height="13" Foreground="#CACACA" IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="245" MaxWidth="350" Background="#262626"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1"
                                    Padding="3">
                                <ScrollViewer MaxHeight="300" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DeviceSurface" Property="Background" Value="#383838"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="DeviceSurface" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DeviceSurface" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ComboBox.Template>
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="MinHeight" Value="36"/>
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinWidth="218" Margin="6 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="39"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:DeviceSymbolControl Grid.Column="0" SymbolText="{Binding Visual.SymbolText}"
                            Foreground="{Binding Visual.BadgeTextBrush}" GlyphSize="27"
                            Width="35" Height="29" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="0" Text="F" FontSize="19" FontWeight="Bold"
                                   Foreground="#B8C5B8" TextAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="Filter">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF"
                            FontSize="13" VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Bind and options form ONE compact, intrinsic-width action group.
             A lone Bind command must not stretch into a 600px blue slab. -->
        <Grid x:Name="BindingActionGroup" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
              HorizontalAlignment="Left" MinWidth="80" MaxWidth="300" MinHeight="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="38"/>
                <ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>
        <Grid x:Name="BindSurface" Grid.Column="0" Margin="0" ClipToBounds="True">
            <Button x:Name="BindButton" MinHeight="36" MinWidth="0" Padding="2 0"
                    IsEnabled="{Binding CanBindCurrentDevice}"
                    Click="BindButton_OnClick"
                    PreviewMouseLeftButtonDown="BindButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonDown="BindButton_OnPreviewMouseRightButtonDown"
                    Foreground="#FFFFFF"
                    HorizontalContentAlignment="Stretch"
                    materialDesign:TransitionAssist.DisableTransitions="True"
                    ToolTip="Waiting for input: click again, right-click or press Esc to cancel">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CompactBindSurfaceButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Background" Value="#9A4D16"/>
                                <Setter Property="BorderBrush" Value="#F0B869"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding CompactBindButtonText}"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="NoWrap" MaxHeight="36" Margin="1 0"/>
            </Button>
            <ProgressBar Height="3" Margin="8 0 8 2" VerticalAlignment="Bottom"
                         Minimum="0" Maximum="100" Value="{Binding PreviewValue, Mode=OneWay}"
                         IsHitTestVisible="False">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowButtonPreview}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>

        <Button Grid.Column="1" x:Name="MenuButton" Margin="0" Width="42" MinHeight="36" Padding="0"
                IsEnabled="{Binding BindingEnabled}" Click="MenuButton_OnClick"
                Style="{StaticResource CompactBindOptionsButton}"
                ToolTip="Binding options">
            <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"/>
            <Button.ContextMenu>
                <ContextMenu x:Name="Ddl" Style="{StaticResource MaterialDesignContextMenu}"
                             Foreground="#FFFFFF" Background="#242424"/>
            </Button.ContextMenu>
        </Button>
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical"
                    Margin="4 0 0 2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="Block this binding">
            <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Width" Value="62"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactDirectional, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="Width" Value="30"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowBlock}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <!-- A device-only picker must not paint an orphaned Block
                             toggle outside its zero-width action column. -->
                        <DataTrigger Binding="{Binding DeviceOnly, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
        <TextBlock Foreground="#E2E2E2" FontSize="11" Margin="0 0 0 4"
                   HorizontalAlignment="Center" TextWrapping="NoWrap">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Text" Value="Block"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactDirectional, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="FontSize" Value="9"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsChecked="{Binding Block, Mode=TwoWay}"
                      IsEnabled="{Binding CanBlock}"
                      ToolTip="Block original physical input from reaching the game (supported input providers only)"
                      ToolTipService.ShowOnDisabled="True">
            <ToggleButton.Style>
                <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource CompactBlockSwitch}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CompactDirectional, RelativeSource={RelativeSource AncestorType={x:Type local:CompactInputBindingControl}}}" Value="True">
                            <Setter Property="Width" Value="26"/>
                            <Setter Property="Height" Value="18"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowBlock}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
        </StackPanel>

    </Grid>
</UserControl>
