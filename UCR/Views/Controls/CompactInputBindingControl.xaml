<UserControl x:Class="HidWizards.UCR.Views.Controls.CompactInputBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             UseLayoutRounding="True"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <Style x:Key="CompactBlockSwitch" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="#515151"/>
            <Setter Property="BorderBrush" Value="#737373"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3 0 0 0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#F2F2F2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid MinHeight="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*" MinWidth="90"/>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="92"/>
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Row="0" Grid.Column="0" x:Name="DeviceSelectionBox"
                  Width="54" Height="36" Margin="0 0 4 0" Padding="0"
                  BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="2"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  IsEnabled="{Binding BindingEnabled}"
                  SelectionChanged="DeviceSelectionBox_OnSelectionChanged"
                  ToolTip="Select binding device">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="MinWidth" Value="180"/>
                </Style>
            </ComboBox.ItemContainerStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinWidth="31" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Render the actual glyph at selector size, without a fixed-size parent template. -->
                        <local:DeviceSymbolControl Grid.Column="0"
                                                   SymbolText="{Binding Visual.SymbolText}"
                                                   Foreground="{Binding Visual.BadgeTextBrush}"
                                                   GlyphSize="27" Width="30" Height="30"
                                                   Margin="0" VerticalAlignment="Center"
                                                   ToolTip="{Binding Visual.ToolTip}"/>
                        <TextBlock Grid.Column="1" Margin="8 0 8 0" Text="{Binding Title}" Foreground="#FFFFFF"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- The selection displays only its device glyph; the
                                             opened dropdown displays full device names. -->
                                        <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Grid.Row="0" Grid.Column="1" Margin="0 0 0 0">
            <Button x:Name="BindButton" MinHeight="32" MinWidth="120"
                    Content="{Binding CompactBindButtonText}"
                    IsEnabled="{Binding BindingEnabled}"
                    Click="BindButton_OnClick"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Foreground="#FFFFFF"
                    materialDesign:TransitionAssist.DisableTransitions="True"
                    ToolTip="{Binding BindingActionToolTip}"/>
            <ProgressBar Height="3" Margin="8 0 8 2" VerticalAlignment="Bottom"
                         Minimum="0" Maximum="100" Value="{Binding PreviewValue, Mode=OneWay}"
                         IsHitTestVisible="False">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowButtonPreview}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </Grid>

        <Button Grid.Row="0" Grid.Column="2" x:Name="MenuButton" Margin="2 0 0 0" Width="32" MinHeight="32" Padding="0"
                IsEnabled="{Binding BindingEnabled}" Click="MenuButton_OnClick"
                Style="{StaticResource MaterialDesignRaisedButton}" Foreground="#FFFFFF"
                ToolTip="Binding options">
            <materialDesign:PackIcon Kind="DotsVertical" Width="18" Height="18"/>
            <Button.ContextMenu>
                <ContextMenu x:Name="Ddl" Style="{StaticResource MaterialDesignContextMenu}"
                             Foreground="#FFFFFF" Background="#242424"/>
            </Button.ContextMenu>
        </Button>

        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowBlock}"
                    ToolTip="Block the original physical input (where the provider supports it)">
        <TextBlock Text="Block" Foreground="#E2E2E2" FontSize="11" Margin="0 0 0 3"
                   HorizontalAlignment="Center"/>
        <ToggleButton HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsChecked="{Binding Block, Mode=TwoWay}"
                      IsEnabled="{Binding CanBlock}"
                      ToolTip="Block original physical input from reaching the game (supported input providers only)"
                      ToolTipService.ShowOnDisabled="True">
            <ToggleButton.Style>
                <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource CompactBlockSwitch}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowBlock}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowInvertInput}"
                    ToolTip="Invert the physical input axis direction">
            <TextBlock Text="Invert" Foreground="#E2E2E2" FontSize="12"
                       Margin="0 0 5 0" VerticalAlignment="Center"/>
            <ToggleButton IsChecked="{Binding InvertInput, Mode=TwoWay}"
                          IsEnabled="{Binding BindingEnabled}" Style="{StaticResource CompactBlockSwitch}"/>
        </StackPanel>
    </Grid>
</UserControl>
