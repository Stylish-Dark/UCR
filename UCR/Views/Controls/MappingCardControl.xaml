<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DataContext="{d:DesignData Source=/SampleData/MappingControlSampleData.xaml}"
             d:DesignHeight="500" d:DesignWidth="600">
    <materialDesign:Card Margin="4 5" Background="#212121">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  Background="#212121"
                  Style="{StaticResource MaterialDesignExpander}">
            <Expander.Header>
                <Grid Margin="2 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MappingTitle}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MappingRoute}" Margin="0 2 0 0" Opacity="0.72" Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding ButtonsEnabled}" VerticalAlignment="Center">
                        <Button ToolTip="Rename mapping"
                                Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="20" Height="20"/>
                        </Button>
                        <Button ToolTip="Add plugin to mapping"
                                Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                Click="AddPlugin_OnClick">
                            <materialDesign:PackIcon Kind="LibraryAdd" Width="20" Height="20"/>
                        </Button>
                        <Button ToolTip="Remove mapping"
                                Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                Click="Remove_OnClick">
                            <materialDesign:PackIcon Kind="Trash" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="8 4 8 8">
                <materialDesign:Card Padding="8" Background="#212121">
                    <ItemsControl ItemsSource="{Binding DeviceBindings}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DeviceBindingControl DataContext="{Binding}"
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            Label="{Binding DeviceBindingName}"
                                                            Category="{Binding DeviceBindingCategory}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </materialDesign:Card>

                <ItemsControl ItemsSource="{Binding Plugins}" VerticalAlignment="Stretch">
                    <ItemsControl.Resources>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <plugin:PluginControl Margin="0 6 0 0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
    </materialDesign:Card>
</UserControl>
