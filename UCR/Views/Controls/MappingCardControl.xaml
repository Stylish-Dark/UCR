<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             x:Name="MappingCardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
            <Setter Property="Foreground" Value="#DADADA"/>
            <Setter Property="Opacity" Value="0.84"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UcrMappingDeleteButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource UcrMappingActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A device badge is intentionally shown only when the mapping deviates from the profile's
             primary device, unless the user explicitly enables the Show all devices toggle. -->
        <DataTemplate x:Key="MappingBindingVisualTemplate">
            <Grid Margin="2 0" MinHeight="39" ClipToBounds="False" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Blocking here means interception/rerouting, not an error. Use the active accent. -->
                <TextBlock Grid.Column="0" Text="⊘" Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="16" FontWeight="Bold" Margin="0 0 4 0"
                           VerticalAlignment="Bottom" Padding="0 0 0 3"
                           ToolTip="Input blocking enabled">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlockedInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Column="1" HorizontalAlignment="Center" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Only non-primary/explicitly-requested device identity is shown, above the control. -->
                    <local:DeviceSymbolControl Grid.Row="0"
                                               SymbolText="{Binding Device.SymbolText}"
                                               Foreground="{Binding Device.BadgeTextBrush}"
                                               GlyphSize="24" Width="38" Height="25" Margin="0 0 0 2"
                                               ToolTip="{Binding Device.ToolTip}">
                        <local:DeviceSymbolControl.Style>
                            <Style TargetType="{x:Type local:DeviceSymbolControl}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowDeviceBadge}" Value="True"/>
                                            <Condition Binding="{Binding Device.HasSymbol}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:DeviceSymbolControl.Style>
                    </local:DeviceSymbolControl>

                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <local:ControlGlyphControl Kind="{Binding ControlKind}"
                                               AccentBrush="{Binding ControlBrush}"
                                               Label="{Binding ControlLabel}"
                                               HorizontalAlignment="Center">
                        <local:ControlGlyphControl.Style>
                            <Style TargetType="{x:Type local:ControlGlyphControl}">
                                <Setter Property="Width" Value="42"/>
                                <Setter Property="Height" Value="37"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                        <Setter Property="Width" Value="20"/>
                                        <Setter Property="Height" Value="20"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ControlGlyphControl.Style>
                    </local:ControlGlyphControl>
                    <!-- Negation preserves the actual input glyph and crosses it out,
                         instead of replacing it with text or hiding its identity. -->
                    <Line X1="5" Y1="32" X2="37" Y2="5"
                          Stroke="#D9D9D9" StrokeThickness="2.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          IsHitTestVisible="False">
                        <Line.Style>
                            <Style TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNegatedInput}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ExpandedMappingBodyTemplate">
            <Border Margin="2 0 2 3" Padding="6 5" Background="#202020"
                    BorderBrush="#303030" BorderThickness="0 1 0 0" CornerRadius="0">
                <StackPanel>
                    <StackPanel Margin="0 0 0 4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Outputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="6 0 0 5">
                            <materialDesign:PackIcon Kind="ArrowCollapseLeft" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="INPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+" Width="30" Height="28" Margin="12 0 0 0"
                                    Click="AddCondition_OnClick" IsEnabled="{Binding ButtonsEnabled}"
                                    Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                                    ToolTip="Add another input OR condition"/>
                        </StackPanel>
                    <!-- Non-boolean plugins retain the full legacy editor. -->
                    <ItemsControl ItemsSource="{Binding DeviceBindings}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportsNativeInputExpression}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DeviceBindingControl DataContext="{Binding}" DeviceBinding="{Binding DeviceBinding}"
                                                            Label="{Binding DeviceBindingName}" Category="{Binding DeviceBindingCategory}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel DataContext="{Binding Plugins[0]}">
                                        <!-- Input mode belongs with input binding, never in output selection. -->
                                        <WrapPanel Orientation="Horizontal" Margin="4 5 0 2"
                                                    Visibility="{Binding AxisButtonModeVisibility}">
                                            <TextBlock Text="Axis input mode" Foreground="#D8D8D8"
                                                       VerticalAlignment="Center" Margin="0 0 10 0"
                                                       ToolTip="One button: pressed/released axis values. Two buttons: positive/negative directions."/>
                                            <Button Content="1" MinWidth="42" Height="30" Padding="10 2"
                                                    Margin="0 0 4 0" Click="AxisOneButton_OnClick"
                                                    IsEnabled="{Binding CanChangeAxisButtonMode}"
                                                    ToolTip="Use one button and set axis values for press and release"
                                                    Foreground="White">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <Setter Property="Background" Value="#353535"/>
                                                        <Setter Property="BorderBrush" Value="#666666"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOneButtonAxis}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="2" MinWidth="42" Height="30" Padding="10 2"
                                                    Click="AxisTwoButtons_OnClick"
                                                    IsEnabled="{Binding CanChangeAxisButtonMode}"
                                                    ToolTip="Use separate buttons for the positive and negative axis directions"
                                                    Foreground="White" Margin="0 0 4 0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <Setter Property="Background" Value="#353535"/>
                                                        <Setter Property="BorderBrush" Value="#666666"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTwoButtonAxis}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                             <Button Content="4" MinWidth="42" Height="30" Padding="10 2" Click="AxisFourButtons_OnClick"
                                                     IsEnabled="{Binding CanChangeAxisButtonMode}" ToolTip="Four directions: Up, Down, Left and Right"
                                                     Foreground="White">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <Setter Property="Background" Value="#353535"/>
                                                        <Setter Property="BorderBrush" Value="#666666"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFourButtonAxis}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                        </WrapPanel>
                                         <StackPanel Margin="5 6 0 6" Visibility="{Binding FourButtonPresetVisibility}">
                                             <StackPanel Visibility="{Binding KeyboardAxisPresetVisibility}">
                                             <TextBlock Text="Keyboard presets" Foreground="#D8D8D8" FontWeight="SemiBold" Margin="0 0 0 5"/>
                                             <WrapPanel>
                                                 <Button Content="WASD" Tag="WASD" Click="AxisKeyboardPreset_OnClick" Margin="0 0 5 4" ToolTip="W up, S down, A left, D right"/>
                                                 <Button Content="Arrows" Tag="Arrows" Click="AxisKeyboardPreset_OnClick" Margin="0 0 5 4"/>
                                                 <Button Content="Numpad" Tag="Numpad" Click="AxisKeyboardPreset_OnClick" Margin="0 0 5 4" ToolTip="Numpad 8, 2, 4, 6"/>
                                                 <Button Content="U/J + H/K" Tag="UJHK" Click="AxisKeyboardPreset_OnClick" Margin="0 0 5 4"/>
                                             </WrapPanel>
                                             </StackPanel>
                                             <StackPanel Visibility="{Binding ControllerAxisPresetVisibility}">
                                             <TextBlock Text="Controller presets" Foreground="#D8D8D8" FontWeight="SemiBold" Margin="0 7 0 5"/>
                                             <Button Content="D-pad" Tag="DPad" Click="AxisControllerPreset_OnClick"
                                                     Height="30" Padding="12 2" HorizontalAlignment="Left"
                                                     ToolTip="Assign Up, Down, Left and Right from the selected controller's D-pad"/>
                                             </StackPanel>
                                             <StackPanel Orientation="Horizontal" Margin="0 9 0 0">
                                                 <CheckBox Content="Invert horizontal" Margin="0 0 15 0"
                                                           IsChecked="{Binding Plugin.InvertX, Mode=OneWay}"
                                                           Click="AxisInvertX_OnClick" Foreground="#E2E2E2"/>
                                                 <CheckBox Content="Invert vertical"
                                                           IsChecked="{Binding Plugin.InvertY, Mode=OneWay}"
                                                           Click="AxisInvertY_OnClick" Foreground="#E2E2E2"/>
                                             </StackPanel>
                                         </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="5 8 0 5" Visibility="{Binding ControllerStickPresetVisibility}">
                        <TextBlock Text="Controller input presets" FontWeight="SemiBold"
                                   Foreground="#D8D8D8" Margin="0 0 0 5"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Left stick" Tag="0" Click="AxisStickInputPreset_OnClick"
                                    Height="30" Margin="0 0 5 0" Padding="10 2"
                                    ToolTip="Assign both analogue axes from the selected controller's left stick"/>
                            <Button Content="Right stick" Tag="2" Click="AxisStickInputPreset_OnClick"
                                    Height="30" Padding="10 2"
                                    ToolTip="Assign both analogue axes from the selected controller's right stick"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- One row is one input condition. Terms within the row are ANDed; rows are ORed. -->
                    <StackPanel Margin="2 0 2 3">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SupportsNativeInputExpression}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ItemsControl ItemsSource="{Binding InputConditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0 0 0 9">
                                        <TextBlock Text="OR" Visibility="{Binding OrLabelVisibility}"
                                                   Foreground="#B4B4B4" FontWeight="Bold" FontSize="12"
                                                   Margin="4 7 0 6"/>
                                        <Border Background="#353535" BorderBrush="#555555" BorderThickness="1"
                                                CornerRadius="4" Padding="7 8 7 7">
                                          <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Inputs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0 0 0 3" Padding="5" CornerRadius="3"
                                                            Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="205"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <local:CompactInputBindingControl Grid.Column="0" DataContext="{Binding}"
                                                                                                DeviceBinding="{Binding DeviceBinding}"
                                                                                                HorizontalAlignment="Stretch"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center" Margin="4 0 0 0">
                                                                <ToggleButton Content="NOT" Width="54" Height="30" Margin="0 0 12 0"
                                                                              IsChecked="{Binding InputExpressionNegated, Mode=OneWay}"
                                                                              Click="InputNegated_OnClick"
                                                                              Foreground="#FFFFFF" Background="#343434"
                                                                              BorderBrush="#626262" BorderThickness="1"
                                                                              ToolTip="Invert this input condition">
                                                                    <ToggleButton.Style>
                                                                        <Style TargetType="ToggleButton">
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                                        <Border x:Name="NotSurface" Background="#343434"
                                                                                                BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                                              VerticalAlignment="Center"
                                                                                                              TextElement.Foreground="#FFFFFF"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="NotSurface" Property="Background" Value="#164AA7"/>
                                                                                                <Setter TargetName="NotSurface" Property="BorderBrush" Value="#397AF0"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ToggleButton.Style>
                                                                </ToggleButton>
                                                                <Button Click="RemoveExpressionInput_OnClick"
                                                                        IsEnabled="{Binding CanRemoveExpressionInput}"
                                                                        ToolTip="Remove input condition" ToolTipService.ShowOnDisabled="True"
                                                                        Style="{StaticResource UcrDeleteItemButton}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="2 4 0 0">
                                            <Button Content="+ AND input" Height="34" Margin="0 0 7 0"
                                                    IsEnabled="{Binding DataContext.ButtonsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}"
                                                    Click="AddInputToCondition_OnClick"
                                                    Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                                                    ToolTip="Require another input together with this one"/>
                                            <Button Content="Remove OR group" Height="34"
                                                    Click="RemoveCondition_OnClick"
                                                    Foreground="#BBBBBB" ToolTip="Remove this alternative input group">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemoveCondition}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    </StackPanel>
                    <Border Background="#3A3A3A" Height="1" Margin="3 10 3 15">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Inputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Outputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <StackPanel Margin="0 0 0 3">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Inputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal" Margin="8 0 0 10">
                            <materialDesign:PackIcon Kind="ArrowCollapseRight" Width="16" Height="16"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="OUTPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="+" Width="30" Height="28" Margin="12 0 0 0"
                                    IsEnabled="{Binding ButtonsEnabled}" Click="AddPlugin_OnClick"
                                    Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                                    ToolTip="Add another output binding"/>
                        </StackPanel>
                    <!-- Each output is a separate vertical row. Never overflow sideways. -->
                    <StackPanel Margin="2 0 2 3">
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0 0 0 2" Padding="5" Background="#292929"
                                            BorderBrush="#454545" BorderThickness="1" CornerRadius="3">
                                        <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="205"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="0 1 7 0" Padding="6 2"
                                                    Height="32" MinWidth="76" Click="ChangeOutputType_OnClick"
                                                    ToolTip="Change this output's type"
                                                    IsEnabled="{Binding MappingViewModel.ButtonsEnabled}"
                                                    Background="#383838" Foreground="#FFFFFF" BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding OutputType}" VerticalAlignment="Center"/>
                                                    <materialDesign:PackIcon Kind="ChevronDown" Margin="4 0 0 0"
                                                                             Width="14" Height="14" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding DeviceBindings}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="{x:Type ItemsControl}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFourButtonAxis}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <local:CompactInputBindingControl DataContext="{Binding}"
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            HorizontalAlignment="Stretch" Margin="0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Four-way output device and its logical destination are independently selectable. -->
                                            <StackPanel Grid.Column="1" Margin="0 1 0 1">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFourButtonAxis}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ComboBox Height="30" Margin="0 0 0 5"
                                                          ItemsSource="{Binding FourWayOutputDevices}"
                                                          SelectedValuePath="Guid"
                                                          SelectedValue="{Binding SelectedFourWayOutputDeviceGuid, Mode=TwoWay}"
                                                          DisplayMemberPath="Title"
                                                          IsEnabled="{Binding MappingViewModel.ButtonsEnabled}"
                                                          ToolTip="Select output controller"/>
                                            <!-- Four directions form ONE destination: do not expose X/Y binding buttons. -->
                                            <Button Height="36" Margin="0"
                                                    Content="{Binding FourWayOutputLabel}"
                                                    Click="FourWayOutput_OnClick"
                                                    IsEnabled="{Binding MappingViewModel.ButtonsEnabled}"
                                                    Foreground="#FFFFFF" ToolTip="Choose D-pad, left stick or right stick">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFourButtonAxis}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            </StackPanel>
                                            <Button Grid.Column="2" HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom" Margin="7 0 0 1"
                                                    Click="RemoveOutput_OnClick" IsEnabled="{Binding CanRemove}"
                                                    ToolTip="Remove this output" ToolTipService.ShowOnDisabled="True"
                                                    Style="{StaticResource UcrDeleteItemButton}"/>
                                        </Grid>
                                        <!-- Compact workspace must expose the same filter and plugin-property
                                             editors as the classic expanded plugin UI. -->
                                        <StackPanel Margin="2 3 2 0">
                                            <Button HorizontalAlignment="Left" Width="34"
                                                    Height="30" Padding="3"
                                                    Click="AddOutputFilter_OnClick"
                                                    IsEnabled="{Binding CanAddFilter}"
                                                    Foreground="#FFFFFF" Background="#353535"
                                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1"
                                                    ToolTip="Add filter to this output">
                                                <materialDesign:PackIcon Kind="Plus" Width="19" Height="19"/>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Filters}" Margin="0 4 0 0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0 0 6 3">
                                                            <Button Content="{Binding Name}" Click="ToggleOutputFilter_OnClick"
                                                                    Height="28" Padding="8 1"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FFFFFF" Background="#353535"
                                                                    BorderBrush="#5C5C5C" BorderThickness="1"
                                                                    ToolTip="Toggle filter inversion"/>
                                                            <Button Content="×" Click="RemoveOutputFilter_OnClick"
                                                                    Height="28" Width="27" Padding="0"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FF6868" FontSize="19"
                                                                    Background="#353535" BorderBrush="#5C5C5C"
                                                                    BorderThickness="1" ToolTip="Remove filter"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding PluginPropertyGroups}" Margin="0 2 0 0">
                                                <ItemsControl.Style>
                                                    <Style TargetType="{x:Type ItemsControl}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFourButtonAxis}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Visibility="{Binding ShowPropertyList}">
                                                            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"
                                                                       Foreground="#DADADA" Margin="0 2 0 1"/>
                                                            <plugin:PluginPropertyListControl DataContext="{Binding}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Margin="0 2" Background="#242424" CornerRadius="0" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFilterReferenceHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="#4B7150"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFilterDefinitionHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource MappingTypeFilterBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Expander x:Name="MappingExpander"
                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch"
                      Background="#242424"
                      Style="{StaticResource MaterialDesignExpander}"
                      Expanded="MappingExpander_OnExpanded"
                      Collapsed="MappingExpander_OnCollapsed">
            <Expander.Header>
                <Grid x:Name="HeaderGrid" MinHeight="74" ToolTip="Right-drag while collapsed to reorder this mapping">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The strip describes what the mapping produces, not what happened to feed it. -->
                    <Border Grid.Column="0" Margin="0 4 0 4" CornerRadius="2"
                            Background="{Binding MappingOutputTypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>

                    <StackPanel Grid.Column="1" Margin="10 6 8 6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MappingTitle}" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingTitle}"/>
                        <ItemsControl ItemsSource="{Binding MappingRouteTokens}" Margin="0 2 0 0" Opacity="0.78">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="Medium"
                                               Foreground="{Binding TypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Symmetric input/output lanes keep every arrow and output origin aligned even
                         when one mapping has one input and another has two or three. -->
                    <Grid Grid.Column="2" x:Name="RouteLaneGrid" Margin="6 5 8 5" VerticalAlignment="Center" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Each OR condition gets its own row; AND inputs remain together.
                                 No hidden fourth input and no squeezing every condition into one line. -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding CollapsedInputRows}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ClipToBounds="False" Cursor="Hand"
                                          PreviewMouseLeftButtonUp="QuickBindInput_OnMouseLeftButtonUp">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Visuals}" Margin="0 1"
                                                      ItemTemplate="{StaticResource MappingBindingVisualTemplate}"
                                                      HorizontalAlignment="Right" ToolTip="Click a glyph to bind this input">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" MaxWidth="162"
                                                               HorizontalAlignment="Right"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Column="1" Text="→" Margin="9 0" FontSize="20" FontWeight="Light"
                                       Foreground="#AFAFAF" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <ItemsControl Grid.Column="2" ItemsSource="{Binding CollapsedOutputVisuals}"
                                          ItemTemplate="{StaticResource MappingBindingVisualTemplate}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ClipToBounds="False" Cursor="Hand"
                                          ToolTip="Click a glyph to bind this output control"
                                          PreviewMouseLeftButtonUp="QuickBindOutput_OnMouseLeftButtonUp">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" MaxWidth="162" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2 3 2 0">
                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickInputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickInputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickInputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickOutputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickOutputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickOutputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- A fixed-width icon lane keeps every mapping route aligned. Filter names
                         live in the tooltip instead of changing card geometry. -->
                    <Border x:Name="FilterIndicator" Grid.Column="3" Width="26" Height="26" Margin="4 0"
                            CornerRadius="4" Background="#162319"
                            BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="1"
                            ToolTip="{Binding FilterIndicatorToolTip}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilterReferences}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14"
                                                 Foreground="{StaticResource MappingTypeFilterBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2 0 6 0">
                        <Border Width="1" Height="22" Margin="1 0 4 0" Background="#3A3A3A"
                                ToolTip="Right-drag a collapsed card to reorder mappings"/>
                        <Button ToolTip="Rename mapping. Stop the active profile to edit." ToolTipService.ShowOnDisabled="True" Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Move this mapping to Main or another group. Stop the active profile to edit." ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource UcrMappingActionButton}" IsEnabled="{Binding ButtonsEnabled}" Click="MoveSection_OnClick">
                            <TextBlock Text="↪" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Button>
                        <Button ToolTip="Remove mapping. Stop the active profile to edit." ToolTipService.ShowOnDisabled="True"
                                Width="30" Height="30" Margin="2" Style="{StaticResource UcrDeleteCrossButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Remove_OnClick"/>
                    </StackPanel>
                </Grid>
            </Expander.Header>
            </Expander>

            <!-- Keep the body outside the Expander template so collapse can animate instead of the
                 template hiding the content instantly. The heavy editor visual tree is still lazy. -->
            <ContentControl x:Name="ExpandedBodyHost"
                            Content="{Binding}"
                            ContentTemplate="{x:Null}"
                            HorizontalContentAlignment="Stretch"
                            Visibility="Collapsed"
                            Height="0"
                            Opacity="0"
                            ClipToBounds="True"/>
        </StackPanel>
    </Border>
</UserControl>
