<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             x:Name="MappingCardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="CompoundVisibilityConverter"/>
        <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
            <Setter Property="Foreground" Value="#DADADA"/>
            <Setter Property="Opacity" Value="0.84"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirectionalTypeChoice" TargetType="{x:Type RadioButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1 0"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Surface" Background="#303030" CornerRadius="3"
                                BorderBrush="#565656" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#164AA7"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#3984F4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#1C1C1C"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#393939"/>
                                <Setter Property="Foreground" Value="#696969"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#233455"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#53678C"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Draw multi-channel selector states with actual geometry instead of
             font-dependent repeated glyphs. Two axes stack vertically; four
             buttons form a balanced two-by-two grid. -->
        <DataTemplate x:Key="DirectionalChoiceGlyphTemplate">
            <Grid Width="26" Height="23" SnapsToDevicePixels="True">
                <TextBlock x:Name="SingleGlyph" Text="{Binding}" FontSize="17"
                           FontWeight="SemiBold" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Canvas x:Name="StackedAxes" Width="25" Height="23"
                        Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Crossed X and Y axes instead of two repeated horizontal arrows. -->
                    <Path Data="M 2,11.5 L 23,11.5 M 2,11.5 L 6,7.5 M 2,11.5 L 6,15.5 M 23,11.5 L 19,7.5 M 23,11.5 L 19,15.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <Path Data="M 12.5,1 L 12.5,22 M 12.5,1 L 8.5,5 M 12.5,1 L 16.5,5 M 12.5,22 L 8.5,18 M 12.5,22 L 16.5,18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
                <Grid x:Name="FourDots" Width="19" Height="19" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Ellipse Grid.Row="0" Grid.Column="0" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                    <Ellipse Grid.Row="0" Grid.Column="1" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                    <Ellipse Grid.Row="1" Grid.Column="0" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                    <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                </Grid>
                <!-- Two unchanged solid dots. Keep explicit insets on every side:
                     the old glyph's right edge was flattened by clipping. -->
                <Canvas x:Name="TwoDots" Width="26" Height="23" ClipToBounds="False"
                        Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center" SnapsToDevicePixels="False">
                    <Ellipse Canvas.Left="5" Canvas.Top="8" Width="7" Height="7"
                             SnapsToDevicePixels="False"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                    <Ellipse Canvas.Left="15" Canvas.Top="8" Width="7" Height="7"
                             SnapsToDevicePixels="False"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"/>
                </Canvas>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="↔↔">
                    <Setter TargetName="SingleGlyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="StackedAxes" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="⠛">
                    <Setter TargetName="SingleGlyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FourDots" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="••">
                    <Setter TargetName="SingleGlyph" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TwoDots" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One NOT style for legacy expressions, typed buttons and AND gates. -->
        <Style x:Key="MappingNotToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="NotSurface" Background="#343434" CornerRadius="3"
                            BorderBrush="#666666" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NotSurface" Property="Background"
                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter TargetName="NotSurface" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NotSurface" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UcrMappingDeleteButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource UcrMappingActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A compact toggle matching Block: inverted output is a binary
             state, not a checkbox that consumes the binding button's width. -->
        <Style x:Key="UcrOutputInvertSwitch" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track" Background="#515151" BorderBrush="#737373"
                                    BorderThickness="1" CornerRadius="11"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3 0 0 0"
                                     Fill="#EAEAEA" HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A device badge is intentionally shown only when the mapping deviates from the profile's
             primary device, unless the user explicitly enables the Show all devices toggle. -->
        <DataTemplate x:Key="MappingBindingVisualTemplate">
            <!-- A real hit-testable button owns each glyph. No click handler on a broad
                 preview panel: the user can only rebind the actual token they click. -->
            <Button Padding="0" Background="Transparent" BorderThickness="0" Focusable="True"
                    Cursor="Hand" ToolTip="{Binding ToolTip}" Click="QuickBindGlyph_OnClick"
                    PreviewMouseLeftButtonDown="QuickBindGlyph_OnPreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonDown="QuickBindGlyph_OnPreviewMouseRightButtonDown">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid Margin="2 0" MinHeight="40" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Blocking here means interception/rerouting, not an error. Use the active accent. -->
                <TextBlock Grid.Column="0" Text="⊘" Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="16" FontWeight="Bold" Margin="0 0 4 0"
                           VerticalAlignment="Bottom" Padding="0 0 0 3"
                           ToolTip="Input blocking enabled">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlockedInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Column="1" HorizontalAlignment="Center" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Only non-primary/explicitly-requested device identity is shown, above the control. -->
                    <local:DeviceSymbolControl Grid.Row="0"
                                               SymbolText="{Binding Device.SymbolText}"
                                               Foreground="{Binding Device.BadgeTextBrush}"
                                               GlyphSize="24" Width="38" Height="25" Margin="0 0 0 1"
                                               ToolTip="{Binding Device.ToolTip}">
                        <local:DeviceSymbolControl.Style>
                            <Style TargetType="{x:Type local:DeviceSymbolControl}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowDeviceBadge}" Value="True"/>
                                            <Condition Binding="{Binding Device.HasSymbol}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:DeviceSymbolControl.Style>
                    </local:DeviceSymbolControl>

                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <local:ControlGlyphControl Kind="{Binding ControlKind}"
                                               AccentBrush="{Binding ControlBrush}"
                                               Label="{Binding ControlLabel}"
                                               HorizontalAlignment="Center">
                        <local:ControlGlyphControl.Style>
                            <Style TargetType="{x:Type local:ControlGlyphControl}">
                                <Setter Property="Width" Value="39"/>
                                <Setter Property="Height" Value="39"/>
                                <Style.Triggers>
                                    <!-- Four keyboard legends need readable keycaps; 39 px shrinks
                                         each to approximately 7 px and makes the letters illegible. -->
                                    <DataTrigger Binding="{Binding ControlKind}" Value="CompoundKeys">
                                        <Setter Property="Width" Value="68"/>
                                        <Setter Property="Height" Value="62"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ControlKind}" Value="CompoundFaceButtons">
                                        <Setter Property="Width" Value="68"/>
                                        <Setter Property="Height" Value="62"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                        <Setter Property="Width" Value="20"/>
                                        <Setter Property="Height" Value="20"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ControlGlyphControl.Style>
                    </local:ControlGlyphControl>
                    <!-- Replace the clicked glyph with an unmistakable active
                         capture state; the existing glyph returns after capture. -->
                    <Border Width="62" Height="39" BorderBrush="#FFD08E" BorderThickness="2"
                            Background="#944916" CornerRadius="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="PRESS" FontSize="11" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Negation preserves the actual input glyph and crosses it out,
                         instead of replacing it with text or hiding its identity. -->
                    <Line X1="5" Y1="34" X2="34" Y2="5"
                          Stroke="#D9D9D9" StrokeThickness="2.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          IsHitTestVisible="False">
                        <Line.Style>
                            <Style TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNegatedInput}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                    </Grid>
                </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Only the existing button-binding workflow is currently editable.
             Existing mappings remain in the model. -->
        <DataTemplate x:Key="ButtonExistingInputsTemplate">
            <ItemsControl ItemsSource="{Binding DeviceBindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CompactInputBindingControl DataContext="{Binding}"
                            DeviceBinding="{Binding DeviceBinding}" Margin="0 0 0 5"
                            HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ButtonInputConditionsTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding InputConditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 0 9">
                                <TextBlock Text="OR" Visibility="{Binding OrLabelVisibility}"
                                    Foreground="#BBBBBB" FontWeight="SemiBold" Margin="4 2 0 6"/>
                                <Border CornerRadius="3" Padding="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#515151"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Background" Value="#2C2C2C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.InputConditions.Count, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="1">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding OrdinaryInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 0 0 5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <local:CompactInputBindingControl Grid.Column="0"
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            DataContext="{Binding}"/>
                                                        <ToggleButton Grid.Column="1" Content="NOT" Width="54" Height="30"
                                                            Margin="4 0 8 0" IsChecked="{Binding InputExpressionNegated, Mode=OneWay}"
                                                            Click="InputNegated_OnClick"
                                                            Style="{StaticResource MappingNotToggle}"
                                                            ToolTip="Negate this Boolean input condition"/>
                                                        <Button Grid.Column="2" Click="RemoveExpressionInput_OnClick"
                                                            IsEnabled="{Binding CanRemoveExpressionInput}"
                                                            Visibility="{Binding CanRemoveExpressionInput, Converter={StaticResource CompoundVisibilityConverter}}"
                                                            ToolTip="Remove input condition"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Style="{StaticResource UcrDeleteItemButton}" Width="32" Height="32" Padding="0" Margin="2 0 0 0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="2 3 0 0">
                                            <Button Content="+ Add input"
                                                Height="29" Padding="8 2" Margin="0 0 7 0"
                                                Click="AddInputToCondition_OnClick"
                                                IsEnabled="{Binding DataContext.ButtonsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}"
                                                Foreground="#FFFFFF"
                                                Style="{StaticResource UcrAccentOutlineButton}"
                                                ToolTip="Add another AND input to this group"/>
                                            <Button Content="Remove group" Click="RemoveCondition_OnClick"
                                                Height="32" Padding="8 2" Foreground="#BBBBBB">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemoveCondition}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </DataTemplate>

        <!-- The representation determines the number of physical bindings.
             4-Way is one logical unit with two internal axis channels. -->
        <!-- Each OR alternative owns exactly one complete logical directional set.
             Compound sets use one visible binding, while Button sets expose the
             two/four independently assignable physical directions. -->
        <!-- Each arrow remains a real physical binding, not a decorative direction.
             The outer-side ellipsis opens that same binding's full category menu. -->
        <DataTemplate x:Key="SpatialDirectionalInputSlotTemplate">
            <Button Width="94" Height="44" Margin="1" Padding="3 2"
                    Click="BindDirectionalSlot_OnClick" IsEnabled="{Binding BindingEnabled}"
                    ToolTip="{Binding DeviceBindingName}" Foreground="#FFFFFF">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter Property="Background" Value="#D77A16"/>
                                <Setter Property="BorderBrush" Value="#FFCB78"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DirectionalGlyph}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CompactBindButtonText}" FontSize="13"
                               TextTrimming="CharacterEllipsis" MaxWidth="79"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Four compass faces share the actual physical axis when the
             source is an analogue stick; digital D-pads have four bindings. -->
        <DataTemplate x:Key="CompoundCompassInputSlotTemplate">
            <StackPanel Width="116" Margin="1">
                <Button Height="55" MinWidth="0" Padding="3 2"
                        Click="BindDirectionalSlot_OnClick"
                        IsEnabled="{Binding PhysicalBinding.BindingEnabled}"
                        ToolTip="{Binding PhysicalBinding.DeviceBindingName}"
                        Foreground="#FFFFFF">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PhysicalBinding.IsCapturing}" Value="True">
                                    <Setter Property="Background" Value="#D77A16"/>
                                    <Setter Property="BorderBrush" Value="#FFCB78"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Arrow}" FontSize="19" FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding PhysicalBinding.CompactBindButtonText}"
                                   FontSize="13" MaxWidth="100" TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ToggleButton Content="NOT" Width="53" Height="24" Padding="1"
                              Margin="0 2 0 0" HorizontalAlignment="Center"
                              Visibility="{Binding PhysicalBinding.DirectionalNegationVisibility}"
                              IsChecked="{Binding PhysicalBinding.InputExpressionNegated, Mode=OneWay}"
                              Click="InputNegated_OnClick"
                              Style="{StaticResource MappingNotToggle}"
                              ToolTip="Negate this digital direction"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TypedDirectionalInputsTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding InputConditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="7" Margin="2 0 2 7"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#454545"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="#292929"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.InputConditions.Count, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="1">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid Margin="3 0 0 7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="OR" Visibility="{Binding OrLabelVisibility}"
                                                       FontSize="12" Foreground="#C6C6C6"
                                                       FontWeight="SemiBold" Margin="0 0 9 0"/>
                                            <TextBlock Text="{Binding DirectionalModeLabel}"
                                                       FontWeight="SemiBold" Foreground="#D0D0D0"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <Border Visibility="{Binding GroupDevicePickerVisibility}"
                                                    Margin="10 0 0 0" ToolTip="Input device for this OR set">
                                                <local:CompactInputBindingControl
                                                    DataContext="{Binding CoreInputs[0]}"
                                                    DeviceBinding="{Binding DeviceBinding}"
                                                    DeviceOnly="True"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding CompoundVisibility}">
                                                <TextBlock Text="Block" Foreground="#D0D0D0" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                                                <ToggleButton Style="{StaticResource UcrOutputInvertSwitch}"
                                                              IsChecked="{Binding DirectionalBlockEnabled, Mode=OneWay}"
                                                              Click="DirectionalBlock_OnClick"
                                                              ToolTip="Block the assigned controls in this OR set"/>
                                            </StackPanel>
                                            <Button Content="×" FontSize="14" Width="24" Height="24"
                                                    Margin="8 0 0 0" Padding="0"
                                                    Click="RemoveCondition_OnClick"
                                                    ToolTip="Remove this OR group"
                                                    Visibility="{Binding OrLabelVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- One compound input is one compact binding action, not a
                                         blue strip consuming the width of the entire input pane. -->
                                    <StackPanel Orientation="Horizontal" Margin="3 4 3 3"
                                                Visibility="{Binding StandaloneCompoundVisibility}">
                                        <Button Click="CompoundPrimaryBind_OnClick"
                                                ToolTip="Bind the axis or choose a complete preset"
                                                HorizontalContentAlignment="Center"
                                                HorizontalAlignment="Left" MinWidth="154" MaxWidth="300"
                                                Height="38" Foreground="#FFFFFF"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                FontWeight="SemiBold" Padding="8 3">
                                            <TextBlock Text="{Binding CompoundPrimaryLabel}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="268"/>
                                        </Button>
                                        <Button Content="⋮" FontSize="20" Width="38"
                                                Visibility="{Binding CompoundAdvancedMenuVisibility}"
                                                Click="CompoundBindingsMenu_OnClick"
                                                ToolTip="Compound binding options"
                                                Height="38" Margin="3 0 0 0" Padding="0"
                                                Foreground="#FFFFFF"
                                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    </StackPanel>
                                    <!-- 4-Way occupies the single compound control above.
                                         Individual implementation channels are not separate user bindings. -->
                                    <StackPanel Visibility="{Binding ButtonPairVisibility}">
                                        <!-- Ordinary one-button mapping: preserve the full selector. -->
                                        <Grid Visibility="{Binding SingleButtonVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <local:CompactInputBindingControl Grid.Column="0"
                                                DataContext="{Binding CoreInputs[0]}"
                                                DeviceBinding="{Binding DeviceBinding}"
                                                HorizontalAlignment="Stretch"/>
                                            <ToggleButton Grid.Column="1" Content="NOT" Width="48" Height="32"
                                                Margin="6 0 0 0" Padding="2 0"
                                                DataContext="{Binding CoreInputs[0]}"
                                                IsChecked="{Binding InputExpressionNegated, Mode=OneWay}"
                                                Click="InputNegated_OnClick"
                                                Style="{StaticResource MappingNotToggle}"
                                                ToolTip="Negate this input condition"/>
                                        </Grid>
                                        <!-- Two buttons driving one axis use the same regular binding
                                             controls as ordinary input rows. No compass or preset menu. -->
                                        <ItemsControl ItemsSource="{Binding CoreInputs}"
                                                      Visibility="{Binding PlainAxisButtonPairVisibility}"
                                                      Margin="2 3 2 3">
                                            <!-- Axis driven by two buttons: equal-width horizontal pair. -->
                                             <ItemsControl.ItemsPanel>
                                                 <ItemsPanelTemplate>
                                                     <UniformGrid Columns="2"/>
                                                 </ItemsPanelTemplate>
                                             </ItemsControl.ItemsPanel>
                                             <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0 0 0 7">
                                                        <TextBlock Text="{Binding DeviceBindingName}"
                                                                   FontSize="12" Foreground="#D5D5D5"
                                                                   Margin="2 0 0 3"/>
                                                        <local:CompactInputBindingControl
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Two or four independent directions surround a preset.
                                             Slot identity and OR membership come from the model. -->
                                        <Grid HorizontalAlignment="Center" Margin="0 2 0 2"
                                              Visibility="{Binding DirectionalButtonsVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="98"/>
                                                <ColumnDefinition Width="98"/>
                                                <ColumnDefinition Width="98"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <!-- Empty up/down slots contribute no height in 2-Way mode. -->
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="44"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ContentControl Grid.Row="0" Grid.Column="1" Tag="↑"
                                                Content="{Binding UpDirection}"
                                                ContentTemplate="{StaticResource SpatialDirectionalInputSlotTemplate}"
                                                Visibility="{Binding UpDirectionVisibility}"/>
                                            <ContentControl Grid.Row="1" Grid.Column="0" Tag="←"
                                                Content="{Binding LeftDirection}"
                                                ContentTemplate="{StaticResource SpatialDirectionalInputSlotTemplate}"
                                                Visibility="{Binding LeftDirectionVisibility}"/>
                                            <Button Grid.Row="1" Grid.Column="1" Content="Preset ▾"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Height="40" Margin="1" Padding="4 2"
                                                    Foreground="#FFFFFF" Click="CompoundPreset_OnClick"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    IsEnabled="{Binding DataContext.ButtonsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}"
                                                    ToolTip="Choose WASD, arrows, D-pad, joystick or face-button compound control"/>
                                            <ContentControl Grid.Row="1" Grid.Column="2" Tag="→"
                                                Content="{Binding RightDirection}"
                                                ContentTemplate="{StaticResource SpatialDirectionalInputSlotTemplate}"
                                                Visibility="{Binding RightDirectionVisibility}"/>
                                            <ContentControl Grid.Row="2" Grid.Column="1" Tag="↓"
                                                Content="{Binding DownDirection}"
                                                ContentTemplate="{StaticResource SpatialDirectionalInputSlotTemplate}"
                                                Visibility="{Binding DownDirectionVisibility}"/>
                                        </Grid>
                                    </StackPanel>
                                    <!-- Existing Boolean AND/NOT operations remain real
                                         input conditions; they are not directional slots. -->
                                    <ItemsControl ItemsSource="{Binding AndInputs}" Margin="0 5 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2 2 0 2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="0"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="AND" FontSize="11"
                                                            Foreground="#CECECE" Margin="1 0 0 3"/>
                                                        <local:CompactInputBindingControl
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            HorizontalAlignment="Stretch"/>
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="1" Content="NOT" Width="48" Height="32"
                                                        Margin="5 15 0 0" Padding="2 0"
                                                        IsChecked="{Binding InputExpressionNegated, Mode=OneWay}"
                                                        Click="InputNegated_OnClick"
                                                        Style="{StaticResource MappingNotToggle}"
                                                        ToolTip="Negate this AND condition"/>
                                                    <Button Grid.Column="2" Width="30" Height="30"
                                                        Margin="5 15 0 0" Padding="0"
                                                        Style="{StaticResource UcrDeleteItemButton}"
                                                        Click="RemoveExpressionInput_OnClick"
                                                        ToolTip="Remove this AND input"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Add input" Click="AddInputToCondition_OnClick"
                                        Height="29" HorizontalAlignment="Left" Padding="8 2"
                                        Margin="2 5 0 0"
                                        IsEnabled="{Binding DataContext.ButtonsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}"
                                        ToolTip="Require another independent condition in this OR group"
                                        Style="{StaticResource UcrAccentOutlineButton}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </DataTemplate>

        <!-- Compact actual output cards for the four arms of a D-pad.
             Device selection, binding, inversion, filters and settings remain live. -->
        <DataTemplate x:Key="DirectionalOutputDPadCardTemplate">
            <!-- 4-Way output positions are real full-size destination buttons.
                 Their device is chosen once in the OUTPUTS header, not repeated
                 as a clipped selector/menu inside every compass arm. -->
            <Border Background="#292929" BorderBrush="#454545"
                    BorderThickness="1" CornerRadius="3" Padding="6 5"
                    Margin="2" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{Binding DirectionalSlotLabel}" Foreground="#D8D8D8"
                               FontSize="13" FontWeight="SemiBold" Margin="2 0 0 5"
                               HorizontalAlignment="Center"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding DeviceBindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="44" MinWidth="0" Margin="0 1 0 2" Padding="3 2"
                                            Click="CompassOutputBind_OnClick"
                                            IsEnabled="{Binding BindingEnabled}"
                                            ToolTip="Choose output control"
                                            Foreground="#FFFFFF"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            HorizontalContentAlignment="Stretch">
                                        <TextBlock Text="{Binding CompactBindButtonText}"
                                                   TextAlignment="Center"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="6 0 0 0"
                                    Visibility="{Binding QuickInvertVisibility}">
                            <TextBlock Text="Invert" FontSize="11" Foreground="#D8D8D8"
                                       HorizontalAlignment="Center" Margin="0 0 0 3"/>
                            <ToggleButton Style="{StaticResource UcrOutputInvertSwitch}"
                                          HorizontalAlignment="Center"
                                          IsChecked="{Binding QuickInvert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Invert this output"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Filters}" Margin="0 4 0 0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0 0 3 0">
                                    <Button Content="{Binding Name}" Click="ToggleOutputFilter_OnClick"
                                            Height="26" Padding="4 1" IsEnabled="{Binding IsEnabled}"
                                            Foreground="#FFFFFF" Background="#353535"
                                            BorderBrush="#5C5C5C" BorderThickness="1"
                                            ToolTip="Toggle output filter"/>
                                    <Button Content="×" Click="RemoveOutputFilter_OnClick"
                                            Height="26" Width="23" Padding="0"
                                            IsEnabled="{Binding IsEnabled}" Foreground="#FF6868"
                                            Background="#353535" BorderBrush="#5C5C5C"
                                            ToolTip="Remove filter"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Settings" Margin="0 3 0 0"
                              Expanded="OutputSettings_OnExpanded"
                              Visibility="{Binding InlineSettingsVisibility}"
                              Foreground="#D0D0D0">
                        <ItemsControl ItemsSource="{Binding InlinePropertyGroups}" Margin="3">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Visibility="{Binding ShowPropertyList}">
                                        <TextBlock Text="{Binding GroupName}"
                                                   Foreground="#DADADA" FontWeight="SemiBold"/>
                                        <plugin:PluginPropertyListControl DataContext="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ButtonMappingEditorTemplate">
            <Border Margin="2 0 2 3" Padding="6 5" Background="#202020"
                BorderBrush="#303030" BorderThickness="0 1 0 0">
                <UniformGrid VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="{x:Type UniformGrid}">
                            <Setter Property="Columns" Value="2"/>
                            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding InspectorMode, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="True"/>
                                        <Condition Binding="{Binding InlineWorkspaceMode, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Columns" Value="1"/>
                                    <Setter Property="Grid.IsSharedSizeScope" Value="False"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <Grid Margin="0 0 6 5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrHeaderRow"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrBodyRow"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrActionsRow"/>
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Outputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid Grid.Row="0" Margin="6 0 0 5" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowCollapseLeft" Width="16" Height="16"
                                Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="INPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="6 0 0 0">
                                <RadioButton Content="✣" Tag="1"
                                             ToolTip="4-Way input" Click="InputRepresentation_OnClick"
                                             IsChecked="{Binding InputIsFullStick, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseInputFourWay}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                                <RadioButton Content="{Binding InputAxisChoiceGlyph}" Tag="2" ContentTemplate="{StaticResource DirectionalChoiceGlyphTemplate}"
                                             FontSize="14" ToolTip="Axis input" Click="InputRepresentation_OnClick"
                                             IsChecked="{Binding InputIsAxis, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseInputAxis}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                                <RadioButton Content="{Binding InputButtonChoiceGlyph}" Tag="3" ContentTemplate="{StaticResource DirectionalChoiceGlyphTemplate}"
                                             ToolTip="Button input" Click="InputRepresentation_OnClick"
                                             IsChecked="{Binding InputIsButton, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseInputButton}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="InputBodySurface" Grid.Row="1" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#454545"/>
                                    <Setter Property="Background" Value="#292929"/>
                                    <Setter Property="CornerRadius" Value="3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMultipleInputConditions}" Value="True">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentControl x:Name="InputBodyHost" Content="{Binding}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <ContentControl.Style>
                                    <Style TargetType="{x:Type ContentControl}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ButtonExistingInputsTemplate}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SupportsNativeInputExpression}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ButtonInputConditionsTemplate}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTypedDirectionalMapping}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource TypedDirectionalInputsTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Border>
                        <Button Grid.Row="2" Content="+OR" Click="AddCondition_OnClick"
                                Height="34" HorizontalAlignment="Left" Padding="12 3"
                                Margin="2 6 0 0" IsEnabled="{Binding ButtonsEnabled}"
                                Visibility="{Binding SupportsNativeInputExpression, Converter={StaticResource CompoundVisibilityConverter}}"
                                Foreground="#FFFFFF"
                                Style="{StaticResource UcrAccentOutlineButton}"
                                ToolTip="Add another complete alternative input set"/>
                    </Grid>
                    <Grid Margin="6 0 0 5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrHeaderRow"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrBodyRow"/>
                            <RowDefinition Height="Auto" SharedSizeGroup="UcrActionsRow"/>
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Inputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid Grid.Row="0" Margin="6 0 0 5" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowCollapseRight" Width="16" Height="16"
                                Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="OUTPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="6 0 0 0">
                                <RadioButton Tag="5"
                                             ToolTip="Filter output" Click="FilterOutput_OnClick"
                                             IsChecked="{Binding OutputIsFilter, Mode=OneWay}"
                                             IsEnabled="{Binding ButtonsEnabled}"
                                             Margin="0 0 9 0"
                                             Style="{StaticResource DirectionalTypeChoice}">
                                    <materialDesign:PackIcon Kind="Filter" Width="17" Height="17"
                                        Foreground="{StaticResource MappingTypeFilterBrush}"/>
                                </RadioButton>
                                <RadioButton Content="✣" Tag="1"
                                             ToolTip="4-Way output" Click="OutputRepresentation_OnClick"
                                             IsChecked="{Binding OutputIsFullStick, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseOutputFourWay}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                                <RadioButton Content="{Binding OutputAxisChoiceGlyph}" Tag="2" ContentTemplate="{StaticResource DirectionalChoiceGlyphTemplate}"
                                             FontSize="14" ToolTip="Axis output" Click="OutputRepresentation_OnClick"
                                             IsChecked="{Binding OutputIsAxis, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseOutputAxis}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                                <RadioButton Content="{Binding OutputButtonChoiceGlyph}" Tag="3" ContentTemplate="{StaticResource DirectionalChoiceGlyphTemplate}"
                                             ToolTip="Button output" Click="OutputRepresentation_OnClick"
                                             IsChecked="{Binding OutputIsButton, Mode=OneWay}"
                                             IsEnabled="{Binding CanChooseOutputButton}"
                                             Style="{StaticResource DirectionalTypeChoice}"/>
                            </StackPanel>

                        </Grid>
                        <Border x:Name="OutputBodySurface" Grid.Row="1" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#454545"/>
                                    <Setter Property="Background" Value="#292929"/>
                                    <Setter Property="CornerRadius" Value="3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOutputDirectionalCompass}" Value="True">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFullStickOutput}" Value="True">
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#535D70"/>
                                            <Setter Property="Background" Value="#242A33"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="4 1 0 7"
                                            Visibility="{Binding FourWayOutputDeviceVisibility}">
                                    <TextBlock Text="{Binding OutputDirectionalGroupTitle}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D0"
                                               VerticalAlignment="Center" Margin="0 0 12 0"/>
                                    <local:CompactInputBindingControl
                                        Width="62" DeviceOnly="True"
                                        DataContext="{Binding Plugins[0].DeviceBindings[0]}"
                                        DeviceBinding="{Binding DeviceBinding}"
                                        ToolTip="{Binding DataContext.FourWayOutputDeviceLabel, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}"/>
                                    <Button Width="34" Height="34" Margin="12 0 0 0"
                                            Style="{StaticResource UcrDeleteItemButton}"
                                            Visibility="{Binding CompoundOutputRemoveVisibility}"
                                            Click="RemoveCompoundOutput_OnClick"
                                            ToolTip="Remove this 4-Way output slot"/>

                                </StackPanel>
                                <!-- 4-Way remains one logical destination even when
                                     implemented as two axes or four D-pad buttons. -->
                                <Border Background="#292929" BorderBrush="#454545"
                                        BorderThickness="1" CornerRadius="3" Padding="7"
                                        Margin="0 0 0 5"
                                        Visibility="{Binding IsCompoundOutput, Converter={StaticResource CompoundVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="38"
                                                Content="{Binding CompoundOutputSummary}"
                                                Click="CompoundOutput_OnClick"
                                                HorizontalContentAlignment="Center"
                                                FontWeight="SemiBold" Foreground="#FFFFFF"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                ToolTip="Choose a complete 4-Way output destination"/>

                                    </Grid>
                                </Border>
                        <!-- Exactly four destination bindings: Up / Left / Right / Down
                             are positioned spatially, not in a vertical stack. -->
                        <Grid x:Name="OutputDirectionalCompassGrid"
                              Visibility="{Binding OutputDirectionalCompassVisibility}"
                              Margin="0 0 0 4" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                                <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="CompassOutputUp"
                                Grid.Row="0" Grid.Column="1" Margin="1"
                                Content="{Binding CompassOutputUp}"
                                HorizontalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource DirectionalOutputDPadCardTemplate}"/>
                            <ContentControl x:Name="CompassOutputLeft"
                                Grid.Row="1" Grid.Column="0" Margin="1"
                                Content="{Binding CompassOutputLeft}"
                                HorizontalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource DirectionalOutputDPadCardTemplate}"/>
                            <ContentControl x:Name="CompassOutputRight"
                                Grid.Row="1" Grid.Column="2" Margin="1"
                                Content="{Binding CompassOutputRight}"
                                HorizontalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource DirectionalOutputDPadCardTemplate}"/>
                            <ContentControl x:Name="CompassOutputDown"
                                Grid.Row="2" Grid.Column="1" Margin="1"
                                Content="{Binding CompassOutputDown}"
                                HorizontalContentAlignment="Stretch"
                                ContentTemplate="{StaticResource DirectionalOutputDPadCardTemplate}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.Style>
                                <Style TargetType="{x:Type ItemsControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompoundOutput}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasOutputDirectionalCompass}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="OutputBindingCardSurface"
                                        CornerRadius="3" Padding="5 4" Margin="0 0 0 3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#292929"/>
                                                <Setter Property="BorderBrush" Value="#454545"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Plugins.Count, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="1">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DirectionalSlotLabel}"
                                                       Visibility="{Binding DirectionalSlotVisibility}"
                                                       Foreground="#D0D0D0" FontSize="12"
                                                       Margin="2 0 0 5"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl Grid.Column="0" ItemsSource="{Binding DeviceBindings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <local:CompactInputBindingControl
                                                                DeviceBinding="{Binding DeviceBinding}"
                                                                DataContext="{Binding}" Tag="Output"
                                                                HorizontalAlignment="Stretch"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Replaces the physical-device selector when this output is a filter.
                                                     It occupies the same destination slot; no extra selection tier. -->
                                                <Button Grid.Column="0" Content="F   Filter ▼"
                                                        Width="140" Height="36" HorizontalAlignment="Left"
                                                        Margin="0 0 0 5" Padding="8 3"
                                                        Foreground="#FFFFFF" Background="#303030"
                                                        BorderBrush="#666666" BorderThickness="1"
                                                        Visibility="{Binding FilterDestinationSelectorVisibility}"
                                                        Click="FilterDestinationSelector_OnClick"
                                                        ToolTip="Change this output to a physical device or keep Filter"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8 0 0 0">
                                                    <StackPanel Orientation="Vertical"
                                                        Visibility="{Binding QuickInvertVisibility}"
                                                        VerticalAlignment="Center" Margin="0 0 9 0">
                                                        <TextBlock Text="Invert" FontSize="11" Foreground="#D8D8D8"
                                                            HorizontalAlignment="Center" Margin="0 0 0 4"/>
                                                        <ToggleButton Style="{StaticResource UcrOutputInvertSwitch}"
                                                            HorizontalAlignment="Center"
                                                            IsChecked="{Binding QuickInvert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            ToolTip="Invert this output"/>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource UcrDeleteItemButton}"
                                                        Click="RemoveOutput_OnClick" IsEnabled="{Binding CanRemove}"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource CompoundVisibilityConverter}}"
                                                        ToolTip="Remove this output slot"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Filters.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ItemsControl ItemsSource="{Binding Filters}" Margin="0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0 0 5 0">
                                                                <Button Content="{Binding Name}" Click="ToggleOutputFilter_OnClick"
                                                                    Height="29" Padding="8 1" IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FFFFFF" Background="#353535"
                                                                    BorderBrush="#5C5C5C" BorderThickness="1"
                                                                    ToolTip="Toggle filter inversion"/>
                                                                <Button Content="×" Click="RemoveOutputFilter_OnClick"
                                                                    Height="29" Width="26" Padding="0"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FF6868" FontSize="18"
                                                                    Background="#353535" BorderBrush="#5C5C5C"
                                                                    BorderThickness="1" ToolTip="Remove filter"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Expander Header="Settings" Margin="0 6 0 0"
                                                Expanded="OutputSettings_OnExpanded"
                                                Visibility="{Binding InlineSettingsVisibility}"
                                                Foreground="#D0D0D0">
                                                <ItemsControl ItemsSource="{Binding InlinePropertyGroups}" Margin="6 4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Visibility="{Binding ShowPropertyList}">
                                                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"
                                                                    Foreground="#DADADA" Margin="0 2 0 1"/>
                                                                <plugin:PluginPropertyListControl DataContext="{Binding}"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 7 0 2">
                            <Button Content="+ Filter" Height="34" Padding="10 2" Margin="3 0 7 0"
                                Click="AddMappingFilter_OnClick" IsEnabled="{Binding ButtonsEnabled}"
                                HorizontalAlignment="Left" Foreground="#FFFFFF" Background="#343434"
                                BorderBrush="#555555" BorderThickness="1"
                                ToolTip="Add a filter to this mapping"/>
                            <Button Content="+ Add output" Click="AddPlugin_OnClick"
                                Visibility="{Binding LegacyOutputAddVisibility}"
                                Height="34" Padding="12 3" Margin="0"
                                HorizontalAlignment="Left" IsEnabled="{Binding ButtonsEnabled}"
                                Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                                ToolTip="Add another output to this mapping"/>
                        </StackPanel>
                    </Grid>
                </UniformGrid>
            </Border>
        </DataTemplate>

        
        <DataTemplate x:Key="ExpandedMappingBodyTemplate"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonMappingEditorTemplate}" HorizontalContentAlignment="Stretch"/></DataTemplate>
    </UserControl.Resources>

    <Border Margin="0 3 0 5" Background="#242424" CornerRadius="6" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="BorderBrush" Value="#5579BE"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Background" Value="#202735"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelectedMapping}" Value="True">
                        <Setter Property="BorderBrush" Value="#78A5FF"/>
                        <Setter Property="BorderThickness" Value="2.5"/>
                        <Setter Property="Background" Value="#202735"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelectedMapping}" Value="True"/>
                            <Condition Binding="{Binding IsExpanded}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="BorderBrush" Value="#78A5FF"/>
                        <Setter Property="BorderThickness" Value="2.5"/>
                    </MultiDataTrigger>

                    <DataTrigger Binding="{Binding IsFilterReferenceHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="#4B7150"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFilterDefinitionHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource MappingTypeFilterBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- The single mapping header belongs to ProfilePage.xaml.
                 This control renders the expanded editor only. -->
            <!-- Keep the body outside the Expander template so collapse can animate instead of the
                 template hiding the content instantly. The heavy editor visual tree is still lazy. -->
            <ContentControl x:Name="ExpandedBodyHost"
                            Content="{Binding}"
                            ContentTemplate="{x:Null}"
                            HorizontalContentAlignment="Stretch"
                            Visibility="Collapsed"
                            Opacity="0"
                            ClipToBounds="True"/>
        </StackPanel>
    </Border>
</UserControl>
