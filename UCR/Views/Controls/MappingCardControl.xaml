<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             x:Name="MappingCardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="Opacity" Value="0.58"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UcrMappingDeleteButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource UcrMappingActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A device badge is intentionally shown only when the mapping deviates from the profile's
             primary device, unless the user explicitly enables the Show all devices toggle. -->
        <DataTemplate x:Key="MappingBindingVisualTemplate">
            <Border Margin="3 0" MinHeight="38" ClipToBounds="False"
                    CornerRadius="4" ToolTip="{Binding ToolTip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="6 4"/>
                        <Setter Property="MinWidth" Value="64"/>
                        <Setter Property="Background" Value="#1D1D1D"/>
                        <Setter Property="BorderBrush" Value="#353535"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                <Setter Property="Background" Value="#191919"/>
                                <Setter Property="BorderBrush" Value="{StaticResource MappingTypeFilterBrush}"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Padding" Value="7 4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ClipToBounds="False">
                    <Border Margin="0 0 5 0" Padding="4 1" MinWidth="25" CornerRadius="3"
                            Background="#191919" BorderBrush="{Binding Device.AccentBrush}" BorderThickness="1"
                            ToolTip="{Binding Device.ToolTip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDeviceBadge}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Device.BadgeText}" Foreground="{Binding Device.AccentBrush}"
                                   FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <local:ControlGlyphControl Kind="{Binding ControlKind}"
                                               AccentBrush="{Binding ControlBrush}"
                                               Label="{Binding ControlLabel}">
                        <local:ControlGlyphControl.Style>
                            <Style TargetType="{x:Type local:ControlGlyphControl}">
                                <Setter Property="Width" Value="46"/>
                                <Setter Property="Height" Value="27"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                        <Setter Property="Width" Value="20"/>
                                        <Setter Property="Height" Value="20"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ControlGlyphControl.Style>
                    </local:ControlGlyphControl>
                    <TextBlock Margin="5 0 1 0" Text="{Binding ControlLabel}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{Binding ControlBrush}" VerticalAlignment="Center" MaxWidth="180"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Margin="4 5" Background="#242424" CornerRadius="5" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFilterReferenceHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="#4B7150"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFilterDefinitionHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource MappingTypeFilterBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  Background="#242424"
                  Style="{StaticResource MaterialDesignExpander}">
            <Expander.Header>
                <Grid MinHeight="64" ToolTip="Right-drag this card while collapsed to reorder it">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="{Binding FilterColumnWidth, ElementName=MappingCardRoot}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The strip describes what the mapping produces, not what happened to feed it. -->
                    <Border Grid.Column="0" Margin="0 4 0 4" CornerRadius="2"
                            Background="{Binding MappingOutputTypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>

                    <StackPanel Grid.Column="1" Margin="10 6 8 6" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="Right-click to rename mapping"
                                PreviewMouseRightButtonUp="RenameHeader_OnMouseRightButtonUp">
                        <TextBlock Text="{Binding MappingTitle}" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingTitle}"/>
                        <ItemsControl ItemsSource="{Binding MappingRouteTokens}" Margin="0 2 0 0" Opacity="0.78">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="Medium"
                                               Foreground="{Binding TypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Symmetric input/output lanes keep every arrow and output origin aligned even
                         when one mapping has one input and another has two or three. -->
                    <Grid Grid.Column="2" x:Name="RouteLaneGrid" Margin="6 5 8 5" VerticalAlignment="Center" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" ClipToBounds="False">
                                <ItemsControl ItemsSource="{Binding CollapsedInputVisuals}"
                                              ItemTemplate="{StaticResource MappingBindingVisualTemplate}" HorizontalAlignment="Right"
                                              ClipToBounds="False" Cursor="Hand"
                                              ToolTip="Right-click to detect and bind this input"
                                              PreviewMouseRightButtonUp="QuickBindInput_OnMouseRightButtonUp">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Viewbox>

                            <TextBlock Grid.Column="1" Text="→" Margin="9 0" FontSize="20" FontWeight="Light"
                                       Foreground="#AFAFAF" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="False">
                                <ItemsControl ItemsSource="{Binding CollapsedOutputVisuals}"
                                              ItemTemplate="{StaticResource MappingBindingVisualTemplate}" HorizontalAlignment="Left"
                                              ClipToBounds="False" Cursor="Hand"
                                              ToolTip="Right-click to bind this output control"
                                              PreviewMouseRightButtonUp="QuickBindOutput_OnMouseRightButtonUp">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Viewbox>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2 3 2 0">
                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickInputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickInputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickInputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickOutputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickOutputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickOutputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Give filter references a real lane instead of truncating each one to 72px.
                         At genuinely narrow card widths every badge switches to the same icon-only mode. -->
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding ReferencedFilters}" Margin="4 0 4 0"
                                  VerticalAlignment="Center" HorizontalAlignment="Right" ClipToBounds="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2 0" Padding="6 3" CornerRadius="3" Background="Transparent"
                                        BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="1" ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Filter" Width="12" Height="12"
                                                                 Foreground="{StaticResource MappingTypeFilterBrush}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                                    <Setter Property="Margin" Value="0 0 5 0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseCompactFilterBadges, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="True">
                                                            <Setter Property="Margin" Value="0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MappingTypeFilterBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseCompactFilterBadges, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2 0 6 0">
                        <Border Width="1" Height="22" Margin="1 0 4 0" Background="#3A3A3A"
                                ToolTip="Right-drag a collapsed card to reorder mappings"/>
                        <Button ToolTip="Rename mapping" Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Add another output to this mapping" Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="AddPlugin_OnClick">
                            <materialDesign:PackIcon Kind="LibraryAdd" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Remove mapping" Style="{StaticResource UcrMappingDeleteButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Remove_OnClick">
                            <materialDesign:PackIcon Kind="Trash" Width="17" Height="17"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <Border Margin="8 0 8 8" Padding="4 6 4 4" Background="#202020"
                    BorderBrush="#303030" BorderThickness="1 1 1 0" CornerRadius="3">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DeviceBindings}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DeviceBindingControl DataContext="{Binding}" DeviceBinding="{Binding DeviceBinding}"
                                                            Label="{Binding DeviceBindingName}" Category="{Binding DeviceBindingCategory}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Plugins}" VerticalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><plugin:PluginControl Margin="0 4 0 0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Expander>
    </Border>
</UserControl>
