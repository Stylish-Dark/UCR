<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <Border Margin="3 4"
            Background="#212121"
            BorderBrush="#3D63BF"
            BorderThickness="1"
            CornerRadius="3">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  Background="#212121"
                  Style="{StaticResource MaterialDesignExpander}">
            <Expander.Header>
                <Grid Margin="2 0 0 0" MinHeight="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MappingTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding MappingRouteTokens}" Margin="0" Opacity="0.9">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="11"
                                               Foreground="{Binding TypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Filter" Width="17" Height="17" Margin="5 0 7 0"
                                                 Foreground="{StaticResource MappingTypeFilterBrush}"
                                                 ToolTip="This mapping uses one or more filters">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasFilters}" Value="True"/>
                                                <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <Button ToolTip="Move mapping up" Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                IsEnabled="{Binding CanMoveUp}" Click="MoveUp_OnClick">
                            <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18"/>
                        </Button>
                        <Button ToolTip="Move mapping down" Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                IsEnabled="{Binding CanMoveDown}" Click="MoveDown_OnClick">
                            <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18"/>
                        </Button>
                        <Button ToolTip="Rename mapping" Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="18" Height="18"/>
                        </Button>
                        <Button ToolTip="Add plugin to mapping" Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="AddPlugin_OnClick">
                            <materialDesign:PackIcon Kind="LibraryAdd" Width="18" Height="18"/>
                        </Button>
                        <Button ToolTip="Remove mapping" Style="{StaticResource MaterialDesignCardButton}"
                                Foreground="{StaticResource PrimaryHueMidForegroundBrush}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Remove_OnClick">
                            <materialDesign:PackIcon Kind="Trash" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <StackPanel Margin="5 1 5 5">
                <ItemsControl ItemsSource="{Binding DeviceBindings}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:DeviceBindingControl DataContext="{Binding}"
                                                        DeviceBinding="{Binding DeviceBinding}"
                                                        Label="{Binding DeviceBindingName}"
                                                        Category="{Binding DeviceBindingCategory}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Plugins}" VerticalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <plugin:PluginControl Margin="0 3 0 0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>
    </Border>
</UserControl>
