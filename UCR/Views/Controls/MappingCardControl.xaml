<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             x:Name="MappingCardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
            <Setter Property="Foreground" Value="#DADADA"/>
            <Setter Property="Opacity" Value="0.84"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UcrMappingDeleteButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource UcrMappingActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A compact toggle matching Block: inverted output is a binary
             state, not a checkbox that consumes the binding button's width. -->
        <Style x:Key="UcrOutputInvertSwitch" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Border x:Name="Track" Background="#515151" BorderBrush="#737373"
                                    BorderThickness="1" CornerRadius="11"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3 0 0 0"
                                     Fill="#EAEAEA" HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"
                                        Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Restore the original compact device-symbol picker on each side.
             The selected device is an icon; the dropdown shows glyph and name. -->
        <Style x:Key="UcrSideDevicePicker" TargetType="{x:Type ComboBox}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ToolTip" Value="{Binding SelectedItem.Title, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="DeviceSurface" CornerRadius="3" Background="#292929"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                    </Grid.ColumnDefinitions>
                                    <local:DeviceSymbolControl Grid.Column="0" IsHitTestVisible="False"
                                        SymbolText="{Binding SelectedItem.Visual.SymbolText, RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="{Binding SelectedItem.Visual.BadgeTextBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                        GlyphSize="31" Width="33" Height="32"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Grid.Column="1" Kind="ChevronDown"
                                        Width="13" Height="13" Foreground="#CACACA" IsHitTestVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.ColumnSpan="2" Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="245" MaxWidth="350" Background="#262626"
                                        BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                        BorderThickness="1" Padding="3">
                                    <ScrollViewer MaxHeight="300" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeviceSurface" Property="Background" Value="#383838"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DeviceSurface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid MinWidth="218" Margin="6 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="39"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:DeviceSymbolControl Grid.Column="0" SymbolText="{Binding Visual.SymbolText}"
                                Foreground="{Binding Visual.BadgeTextBrush}" GlyphSize="27"
                                Width="35" Height="29" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#FFFFFF"
                                FontSize="13" VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UcrNotButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Content" Value="NOT"/>
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="NotSurface" Background="#343434"
                                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NotSurface" Property="Background" Value="#164AA7"/>
                                <Setter TargetName="NotSurface" Property="BorderBrush" Value="#397AF0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NotSurface" Property="BorderBrush" Value="#83AFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UcrDirectionalBindingButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0939B2"/>
            <Setter Property="BorderBrush" Value="#2B70FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1551D1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A device badge is intentionally shown only when the mapping deviates from the profile's
             primary device, unless the user explicitly enables the Show all devices toggle. -->
        <DataTemplate x:Key="MappingBindingVisualTemplate">
            <!-- A real hit-testable button owns each glyph. No click handler on a broad
                 preview panel: the user can only rebind the actual token they click. -->
            <Button Padding="0" Background="Transparent" BorderThickness="0" Focusable="True"
                    Cursor="Hand" ToolTip="{Binding ToolTip}" Click="QuickBindGlyph_OnClick"
                    PreviewMouseLeftButtonDown="QuickBindGlyph_OnPreviewMouseLeftButtonDown"
                    PreviewMouseRightButtonDown="QuickBindGlyph_OnPreviewMouseRightButtonDown">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid Margin="2 0" MinHeight="40" ClipToBounds="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Blocking here means interception/rerouting, not an error. Use the active accent. -->
                <TextBlock Grid.Column="0" Text="⊘" Foreground="{DynamicResource PrimaryHueMidBrush}"
                           FontSize="16" FontWeight="Bold" Margin="0 0 4 0"
                           VerticalAlignment="Bottom" Padding="0 0 0 3"
                           ToolTip="Input blocking enabled">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlockedInput}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Grid.Column="1" HorizontalAlignment="Center" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Only non-primary/explicitly-requested device identity is shown, above the control. -->
                    <local:DeviceSymbolControl Grid.Row="0"
                                               SymbolText="{Binding Device.SymbolText}"
                                               Foreground="{Binding Device.BadgeTextBrush}"
                                               GlyphSize="24" Width="38" Height="25" Margin="0 0 0 1"
                                               ToolTip="{Binding Device.ToolTip}">
                        <local:DeviceSymbolControl.Style>
                            <Style TargetType="{x:Type local:DeviceSymbolControl}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowDeviceBadge}" Value="True"/>
                                            <Condition Binding="{Binding Device.HasSymbol}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:DeviceSymbolControl.Style>
                    </local:DeviceSymbolControl>

                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <local:ControlGlyphControl Kind="{Binding ControlKind}"
                                               AccentBrush="{Binding ControlBrush}"
                                               Label="{Binding ControlLabel}"
                                               HorizontalAlignment="Center">
                        <local:ControlGlyphControl.Style>
                            <Style TargetType="{x:Type local:ControlGlyphControl}">
                                <Setter Property="Width" Value="39"/>
                                <Setter Property="Height" Value="39"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterControl}" Value="True">
                                        <Setter Property="Width" Value="20"/>
                                        <Setter Property="Height" Value="20"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:ControlGlyphControl.Style>
                    </local:ControlGlyphControl>
                    <!-- Replace the clicked glyph with an unmistakable active
                         capture state; the existing glyph returns after capture. -->
                    <Border Width="62" Height="39" BorderBrush="#FFD08E" BorderThickness="2"
                            Background="#944916" CornerRadius="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="PRESS" FontSize="11" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Negation preserves the actual input glyph and crosses it out,
                         instead of replacing it with text or hiding its identity. -->
                    <Line X1="5" Y1="34" X2="34" Y2="5"
                          Stroke="#D9D9D9" StrokeThickness="2.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          IsHitTestVisible="False">
                        <Line.Style>
                            <Style TargetType="Line">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNegatedInput}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Line.Style>
                    </Line>
                    </Grid>
                </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Only the existing button-binding workflow is currently editable.
             Existing mappings remain in the model. -->
        <DataTemplate x:Key="ButtonExistingInputsTemplate">
            <ItemsControl ItemsSource="{Binding DeviceBindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:CompactInputBindingControl DeviceSelectorVisibility="Collapsed" DataContext="{Binding}"
                            DeviceBinding="{Binding DeviceBinding}" Margin="0 0 0 5"
                            HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ButtonInputConditionsTemplate">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding InputConditions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 0 9">
                                <!-- Each compass is a single logical input unit. The physical bindings
                                     are positioned in their actual directions, not as a flat list. -->
                                <StackPanel Visibility="{Binding DirectionalVisibility}" Margin="0 0 0 8">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding DirectionalPairVisibility}"
                                                HorizontalAlignment="Left">
                                        <Button DataContext="{Binding DirectionalInputs[0]}" Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick"
                                                MinWidth="110" MinHeight="38" Margin="0 0 6 0"
                                                Content="{Binding DirectionalBindLabel}" ToolTip="Negative direction"/>
                                        <Button Content="Preset" Width="75" MinHeight="38" Padding="6 2" Margin="0 0 6 0"
                                                Style="{StaticResource UcrAccentOutlineButton}"
                                                Click="OpenDirectionalPresetMenu_OnClick"
                                                ToolTip="Choose a complete input binding preset"/>
                                        <Button DataContext="{Binding DirectionalInputs[1]}" Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick"
                                                MinWidth="110" MinHeight="38" Content="{Binding DirectionalBindLabel}"
                                                ToolTip="Positive direction"/>
                                    </StackPanel>
                                    <Grid Visibility="{Binding FourWayVisibility}" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112"/><ColumnDefinition Width="112"/><ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="1" DataContext="{Binding DirectionalInputs[0]}"
                                                Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick" MinHeight="41" Margin="3"
                                                ToolTip="Up direction">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="↑  "/><TextBlock Text="{Binding CompactBindButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="2" Grid.Column="1" DataContext="{Binding DirectionalInputs[1]}"
                                                Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick" MinHeight="41" Margin="3"
                                                ToolTip="Down direction">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="↓  "/><TextBlock Text="{Binding CompactBindButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="0" DataContext="{Binding DirectionalInputs[2]}"
                                                Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick" MinHeight="41" Margin="3"
                                                ToolTip="Left direction">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="←  "/><TextBlock Text="{Binding CompactBindButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="2" DataContext="{Binding DirectionalInputs[3]}"
                                                Style="{StaticResource UcrDirectionalBindingButton}" Click="BindDirectionalSlot_OnClick" MinHeight="41" Margin="3"
                                                ToolTip="Right direction">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="→  "/><TextBlock Text="{Binding CompactBindButtonText}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Row="1" Grid.Column="1" Content="Preset"
                                                Width="96" MinHeight="38" Padding="5 2" Margin="3"
                                                Style="{StaticResource UcrAccentOutlineButton}"
                                                Click="OpenDirectionalPresetMenu_OnClick"
                                                ToolTip="Choose a complete input binding preset"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0 5 0 0">
                                        <TextBlock Text="Block" VerticalAlignment="Center" Margin="0 0 7 0"/>
                                        <ToggleButton IsChecked="{Binding DirectionalBlockEnabled, Mode=OneWay}"
                                            Click="DirectionalBlock_OnClick" Width="40" Height="22" Margin="0 0 13 0"
                                            Style="{StaticResource UcrOutputInvertSwitch}" />
                                        <ToggleButton IsChecked="{Binding DirectionalPrimary.InputExpressionNegated, Mode=OneWay}"
                                            Click="DirectionalNot_OnClick" Margin="0 0 0 0"
                                            Style="{StaticResource UcrNotButton}" ToolTip="Negate the input condition"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="OR" Visibility="{Binding OrLabelVisibility}"
                                    Foreground="#BBBBBB" FontWeight="SemiBold" Margin="4 2 0 6"/>
                                <Border BorderBrush="#515151" BorderThickness="1"
                                    Background="#2C2C2C" CornerRadius="3" Padding="7">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding OrdinaryInputs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 0 0 5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <local:CompactInputBindingControl DeviceSelectorVisibility="Collapsed" Grid.Column="0"
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            DataContext="{Binding}"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center" Margin="8 0 8 0">
                                                            <ToggleButton IsChecked="{Binding InputExpressionNegated, Mode=OneWay}"
                                                                Click="InputNegated_OnClick"
                                                                Style="{StaticResource UcrNotButton}"
                                                                ToolTip="Negate this input condition"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Click="RemoveExpressionInput_OnClick"
                                                            IsEnabled="{Binding CanRemoveExpressionInput}"
                                                            ToolTip="Remove input condition"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Style="{StaticResource UcrDeleteItemButton}" Width="32" Height="32" Padding="0" Margin="2 0 0 0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="2 3 0 0">
                                            <Button Content="+ AND input" Click="AddInputToCondition_OnClick"
                                                Height="32" Padding="10 3" Margin="0 0 6 0"
                                                Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                                                ToolTip="Add another required input"/>
                                            <Button Content="Remove group" Click="RemoveCondition_OnClick"
                                                Height="32" Padding="8 2" Foreground="#BBBBBB">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemoveCondition}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+ OR input(s)" Click="AddCondition_OnClick"
                    Height="34" HorizontalAlignment="Left" Padding="12 3" Margin="2 3 0 0"
                    IsEnabled="{Binding ButtonsEnabled}" Foreground="#FFFFFF"
                    Style="{StaticResource UcrAccentOutlineButton}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ButtonMappingEditorTemplate">
            <Border Margin="2 0 2 3" Padding="6 5" Background="#202020"
                BorderBrush="#303030" BorderThickness="0 1 0 0">
                <UniformGrid VerticalAlignment="Top">
                    <UniformGrid.Style>
                        <Style TargetType="{x:Type UniformGrid}">
                            <Setter Property="Columns" Value="2"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding InspectorMode, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="True"/>
                                        <Condition Binding="{Binding InlineWorkspaceMode, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Columns" Value="1"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <StackPanel Margin="0 0 6 5">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Outputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="6 0 0 5" Height="30">
                            <materialDesign:PackIcon Kind="ArrowCollapseLeft" Width="16" Height="16"
                                Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="INPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2 2 0 10">
                            <ComboBox Style="{StaticResource UcrSideDevicePicker}" Margin="0 0 9 0"
                                ItemsSource="{Binding InputSideDevices}" SelectedValuePath="Value"
                                SelectedValue="{Binding InputSideDeviceGuid, Mode=OneWay}"
                                IsEnabled="{Binding ButtonsEnabled}"
                                SelectionChanged="InputSideDevice_OnSelectionChanged"/>
                        </StackPanel>
                        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ButtonExistingInputsTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SupportsNativeInputExpression}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ButtonInputConditionsTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="6 0 0 5">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InspectorSection, RelativeSource={RelativeSource AncestorType={x:Type local:MappingCardControl}}}" Value="Inputs">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Background="#252525" BorderBrush="#454545" BorderThickness="1" CornerRadius="4" Padding="8">
                            <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="6 0 0 5" Height="30">
                            <materialDesign:PackIcon Kind="ArrowCollapseRight" Width="16" Height="16"
                                Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="OUTPUTS" Margin="7 0 0 0" Foreground="#D5D5D5"
                                FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2 2 0 10">
                            <ComboBox Style="{StaticResource UcrSideDevicePicker}" Margin="0 0 9 0"
                                ItemsSource="{Binding OutputSideDevices}" SelectedValuePath="Value"
                                SelectedValue="{Binding OutputSideDeviceGuid, Mode=OneWay}"
                                IsEnabled="{Binding ButtonsEnabled}"
                                SelectionChanged="OutputSideDevice_OnSelectionChanged"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OutputBindingSets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#292929" BorderBrush="#454545"
                                            BorderThickness="1" CornerRadius="4" Padding="9" Margin="0 0 0 7">
                                        <StackPanel>
                                            <Grid Margin="0 0 0 5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Caption}" Foreground="#DADADA"
                                                    FontSize="12" FontWeight="SemiBold"
                                                    Visibility="{Binding CaptionVisibility}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{StaticResource UcrDeleteItemButton}"
                                                    Click="RemoveOutputSet_OnClick"
                                                    Visibility="{Binding RemoveVisibility}"
                                                    ToolTip="Remove this complete output Binding Set"/>
                                            </Grid>
                                            <!-- One logical full joystick. The X/Y channels stay
                                                 internal, rather than looking like two outputs. -->
                                            <Button Content="{Binding PresetCaption}" Height="39"
                                                Style="{StaticResource UcrDirectionalBindingButton}"
                                                Visibility="{Binding FullJoystickVisibility}"
                                                Click="OpenOutputPreset_OnClick"
                                                ToolTip="Choose the joystick, including both X and Y axes"/>
                                            <!-- Four buttons are one complete four-way output set.
                                                 The Preset control occupies its centre. -->
                                            <Grid Visibility="{Binding FourWayVisibility}" HorizontalAlignment="Left">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>
                                                <local:CompactInputBindingControl Grid.Row="0" Grid.Column="1"
                                                    DeviceSelectorVisibility="Collapsed" EnableUnifiedOutputPicker="True"
                                                    DataContext="{Binding Slots[2].Binding}"
                                                    DeviceBinding="{Binding Slots[2].Binding.DeviceBinding}" Tag="Output"
                                                    Margin="3" HorizontalAlignment="Stretch"/>
                                                <local:CompactInputBindingControl Grid.Row="1" Grid.Column="0"
                                                    DeviceSelectorVisibility="Collapsed" EnableUnifiedOutputPicker="True"
                                                    DataContext="{Binding Slots[0].Binding}"
                                                    DeviceBinding="{Binding Slots[0].Binding.DeviceBinding}" Tag="Output"
                                                    Margin="3" HorizontalAlignment="Stretch"/>
                                                <local:CompactInputBindingControl Grid.Row="1" Grid.Column="2"
                                                    DeviceSelectorVisibility="Collapsed" EnableUnifiedOutputPicker="True"
                                                    DataContext="{Binding Slots[1].Binding}"
                                                    DeviceBinding="{Binding Slots[1].Binding.DeviceBinding}" Tag="Output"
                                                    Margin="3" HorizontalAlignment="Stretch"/>
                                                <local:CompactInputBindingControl Grid.Row="2" Grid.Column="1"
                                                    DeviceSelectorVisibility="Collapsed" EnableUnifiedOutputPicker="True"
                                                    DataContext="{Binding Slots[3].Binding}"
                                                    DeviceBinding="{Binding Slots[3].Binding.DeviceBinding}" Tag="Output"
                                                    Margin="3" HorizontalAlignment="Stretch"/>
                                                <Button Grid.Row="1" Grid.Column="1"
                                                        Content="Preset" Height="38" Margin="3"
                                                        Style="{StaticResource UcrAccentOutlineButton}"
                                                        Click="OpenOutputPreset_OnClick"
                                                        ToolTip="Choose WASD, Arrow Keys, Numpad, or a controller D-pad"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Slots}"
                                                Visibility="{Binding OrdinaryVisibility}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="{Binding DataContext.Columns,
                                                            RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0 0 5 5">
                                                            <TextBlock Text="{Binding Direction}" Foreground="#DADADA"
                                                                Visibility="{Binding DirectionVisibility}"
                                                                FontSize="12" Margin="2 0 0 5"/>
                                                            <local:CompactInputBindingControl
                                                                DeviceSelectorVisibility="Collapsed"
                                                                EnableUnifiedOutputPicker="True"
                                                                DeviceBinding="{Binding Binding.DeviceBinding}"
                                                                DataContext="{Binding Binding}" Tag="Output"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel DataContext="{Binding Primary}" Margin="0 6 0 0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Content="Invert"
                                                        Visibility="{Binding QuickInvertVisibility}"
                                                        Style="{StaticResource UcrNotButton}"
                                                        IsChecked="{Binding QuickInvert, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="Invert this output"/>
                                                    <Button Content="+ Filter" Height="29" Padding="10 2"
                                                        Click="AddOutputFilter_OnClick" IsEnabled="{Binding CanAddFilter}"
                                                        Foreground="#FFFFFF" Background="#343434" BorderBrush="#555555"
                                                        BorderThickness="1" ToolTip="Add a filter"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Filters}" Margin="0 5 0 0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0 0 5 0">
                                                                <Button Content="{Binding Name}" Click="ToggleOutputFilter_OnClick"
                                                                    Height="29" Padding="8 1" IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FFFFFF" Background="#353535"
                                                                    BorderBrush="#5C5C5C" BorderThickness="1"/>
                                                                <Button Content="×" Click="RemoveOutputFilter_OnClick"
                                                                    Height="29" Width="26" Padding="0"
                                                                    IsEnabled="{Binding IsEnabled}"
                                                                    Foreground="#FF6868" Background="#353535"
                                                                    BorderBrush="#5C5C5C" BorderThickness="1"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Expander Header="Settings" Margin="0 6 0 0"
                                                    Visibility="{Binding InlineSettingsVisibility}"
                                                    Foreground="#D0D0D0">
                                                    <ItemsControl ItemsSource="{Binding InlinePropertyGroups}" Margin="6 4">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Visibility="{Binding ShowPropertyList}">
                                                                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"
                                                                        Foreground="#DADADA" Margin="0 2 0 1"/>
                                                                    <plugin:PluginPropertyListControl DataContext="{Binding}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding AddOutputCaption}" Click="AddPlugin_OnClick"
                            Height="34" Padding="12 3" Margin="3 8 0 2"
                            HorizontalAlignment="Left" IsEnabled="{Binding ButtonsEnabled}"
                            Foreground="#FFFFFF" Style="{StaticResource UcrAccentOutlineButton}"
                            ToolTip="Add another output to this mapping"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </UniformGrid>
            </Border>
        </DataTemplate>

        
        <DataTemplate x:Key="ExpandedMappingBodyTemplate"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ButtonMappingEditorTemplate}" HorizontalContentAlignment="Stretch"/></DataTemplate>
    </UserControl.Resources>

    <Border Margin="0 3 0 5" Background="#242424" CornerRadius="6" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#3A3A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="BorderBrush" Value="#5579BE"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Background" Value="#202735"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFilterReferenceHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="#4B7150"/>
                        <Setter Property="BorderThickness" Value="1.5"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFilterDefinitionHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource MappingTypeFilterBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <!-- Deliberately no Expander here: the whole header must NOT toggle expansion.
                 The sole toggle is ExpandMappingButton, with a separate lazy editor below. -->
            <Border x:Name="MappingHeaderSurface" CornerRadius="5 5 0 0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="#242424"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="Background" Value="#202735"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid x:Name="HeaderGrid" MinHeight="74"
                      ToolTip="Drag the grip on the left to reorder">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="MappingDragHandle" Grid.Column="0" Margin="2" CornerRadius="3" Background="#303030" Cursor="SizeAll" ToolTip="Drag to reorder"><TextBlock Text="☰" Foreground="#D0D0D0" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Border>
                    <!-- The strip describes what the mapping produces, not what happened to feed it. -->
                    <Border Grid.Column="0" Margin="0 4 0 4" Width="3" HorizontalAlignment="Right" IsHitTestVisible="False" CornerRadius="2"
                            Background="{Binding MappingOutputTypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>

                    <StackPanel Grid.Column="1" Margin="10 6 8 6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MappingTitle}" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding MappingTitle}"/>
                        <ItemsControl ItemsSource="{Binding MappingRouteTokens}" Margin="0 2 0 0" Opacity="0.78">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="Medium"
                                               Foreground="{Binding TypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Symmetric input/output lanes keep every arrow and output origin aligned even
                         when one mapping has one input and another has two or three. -->
                    <Grid Grid.Column="2" x:Name="RouteLaneGrid" Margin="6 5 8 5" VerticalAlignment="Center" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ClipToBounds="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Each alternative is a distinct visual row, and AND requirements
                                 stay together in batches of three glyphs. Individual rows may
                                 shrink when needed, never the entire mapping preview. -->
                            <ItemsControl Grid.Column="0" Tag="Input" ItemsSource="{Binding CollapsedInputRows}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          ClipToBounds="False" Cursor="Hand"
>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Right" Margin="0 1">
                                            <Grid Height="17" Margin="0 2 0 2"
                                                  Visibility="{Binding AlternativeDividerVisibility}">
                                                <Border Height="1" Background="#747474"
                                                        VerticalAlignment="Center"/>
                                                <Border HorizontalAlignment="Center" Background="#262626"
                                                        Padding="6 0">
                                                    <TextBlock Text="OR" FontSize="10" FontWeight="Bold"
                                                               Foreground="#BABABA"/>
                                                </Border>
                                            </Grid>
                                            <Grid HorizontalAlignment="Right">
                                                <ItemsControl ItemsSource="{Binding Visuals}"
                                                              ItemTemplate="{StaticResource MappingBindingVisualTemplate}"
                                                              ToolTip="Click a glyph to bind this input">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Column="1" Text="→" Margin="6 0" FontSize="20" FontWeight="Light"
                                       Foreground="#AFAFAF" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <ItemsControl Grid.Column="2" Tag="Output" ItemsSource="{Binding CollapsedOutputRows}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ClipToBounds="False" Cursor="Hand"
>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MaxWidth="166" HorizontalAlignment="Left" Margin="0 1">
                                            <ItemsControl ItemsSource="{Binding Visuals}"
                                                          ItemTemplate="{StaticResource MappingBindingVisualTemplate}"
                                                          ToolTip="Click a glyph to bind this output control">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" MaxWidth="166"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="1" Margin="2 3 2 0">
                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickInputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickInputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickInputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="7 3" CornerRadius="3" Background="#171D29"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuickOutputDetecting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding QuickOutputDetectionStatus}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center"/>
                                    <ProgressBar Height="3" Margin="0 3 0 0" Minimum="0" Maximum="100"
                                                 Value="{Binding QuickOutputDetectionProgress, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryHueLightBrush}" Background="#303030"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- A fixed-width icon lane keeps every mapping route aligned. Filter names
                         live in the tooltip instead of changing card geometry. -->
                    <Border x:Name="FilterIndicator" Grid.Column="3" Width="26" Height="26" Margin="4 0"
                            CornerRadius="4" Background="#162319"
                            BorderBrush="{StaticResource MappingTypeFilterBrush}" BorderThickness="1"
                            ToolTip="{Binding FilterIndicatorToolTip}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilterReferences}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <materialDesign:PackIcon Kind="Filter" Width="14" Height="14"
                                                 Foreground="{StaticResource MappingTypeFilterBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2 0 6 0">
                        <Border Width="1" Height="22" Margin="1 0 4 0" Background="#3A3A3A"
                                ToolTip="Use the grip on the left to reorder"/>
                        <Button ToolTip="Rename mapping. Stop the active profile to edit." ToolTipService.ShowOnDisabled="True" Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Move this mapping to Main or another group. Stop the active profile to edit." ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource UcrMappingActionButton}" IsEnabled="{Binding ButtonsEnabled}" Click="MoveSection_OnClick">
                            <TextBlock Text="↪" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Button>
                        

                    </StackPanel>
                    <!-- Always-visible, dedicated expand control; card content is not a toggle. -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Width="34" Height="34" Margin="0 0 5 0"
                                Style="{StaticResource UcrDeleteCrossButton}"
                                IsEnabled="{Binding ButtonsEnabled}"
                                ToolTip="Delete this mapping"
                                ToolTipService.ShowOnDisabled="True"
                                Click="Remove_OnClick"/>
                    <Button x:Name="ExpandMappingButton" Width="38" Height="38"
                            Margin="0 0 5 0" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Padding="0" Foreground="#FFFFFF" Background="#292929"
                            BorderBrush="#696969" BorderThickness="1" Cursor="Hand" Focusable="False"
                            ToolTip="Expand or collapse mapping details"
                            Click="ExpandMappingButton_OnClick">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Background" Value="#244A88"/>
                                        <Setter Property="BorderBrush" Value="#6D9AEE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#355888"/>
                                        <Setter Property="BorderBrush" Value="#95B8FF"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="24" Height="24" IsHitTestVisible="False">
                            <Path Stroke="#EDF3FF" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 5,9 L 12,16 L 19,9">
                                <Path.Style><Style TargetType="Path"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" CenterX="12" CenterY="12"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="12" CenterY="12"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Keep the body outside the Expander template so collapse can animate instead of the
                 template hiding the content instantly. The heavy editor visual tree is still lazy. -->
            <ContentControl x:Name="ExpandedBodyHost"
                            Content="{Binding}"
                            ContentTemplate="{x:Null}"
                            HorizontalContentAlignment="Stretch"
                            Visibility="Collapsed"
                            Opacity="0"
                            ClipToBounds="True"/>
        </StackPanel>
    </Border>
</UserControl>
