<UserControl x:Class="HidWizards.UCR.Views.Controls.MappingCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             d:DesignHeight="320" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Mapping actions are deliberately subdued until the user interacts with the card. -->
        <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="Opacity" Value="0.58"/>
            <Setter Property="Margin" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UcrMappingDeleteButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource UcrMappingActionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Margin="4 5"
            Background="#242424"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="5"
            SnapsToDevicePixels="True">
        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch"
                  Background="#242424"
                  Style="{StaticResource MaterialDesignExpander}">
            <Expander.Header>
                <Grid MinHeight="56" ToolTip="Right-drag this card while collapsed to reorder it">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Persistent semantic cue. Accent colour remains separate from mapping-type colours. -->
                    <Border Grid.Column="0"
                            Margin="0 4 0 4"
                            CornerRadius="2"
                            Background="{Binding MappingRoute, Converter={StaticResource MappingTypeBrushConverter}}"/>

                    <StackPanel Grid.Column="1" Margin="10 6 8 6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MappingTitle}"
                                   FontSize="15.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding MappingRouteTokens}" Margin="0 2 0 0" Opacity="0.78">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               Foreground="{Binding TypeLabel, Converter={StaticResource MappingTypeBrushConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Collapsed state is visual-first: device family + actual control on each side. -->
                    <Grid Grid.Column="2" Margin="8 5 12 5" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Column="0" ItemsSource="{Binding CollapsedInputVisuals}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2 0" Padding="5 3" MinWidth="58"
                                            Background="#1D1D1D" BorderBrush="#353535" BorderThickness="1" CornerRadius="4"
                                            ToolTip="{Binding ToolTip}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:DeviceGlyphControl Width="34" Height="22"
                                                                      Kind="{Binding Device.Kind}"
                                                                      AccentBrush="{Binding Device.AccentBrush}"
                                                                      SlotNumber="{Binding Device.SlotNumber}"
                                                                      ShowSlotIndicator="{Binding Device.ShowSlotIndicator}">
                                                <local:DeviceGlyphControl.Style>
                                                    <Style TargetType="local:DeviceGlyphControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Device}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:DeviceGlyphControl.Style>
                                            </local:DeviceGlyphControl>
                                            <local:ControlGlyphControl Width="34" Height="22" Margin="4 0 0 0"
                                                                       Kind="{Binding ControlKind}"
                                                                       AccentBrush="{Binding ControlBrush}"
                                                                       Label="{Binding ControlLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Column="1" Text="→" Margin="8 0" FontSize="20" FontWeight="Light"
                                   Foreground="#AFAFAF" VerticalAlignment="Center"/>

                        <ItemsControl Grid.Column="2" ItemsSource="{Binding CollapsedOutputVisuals}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2 0" Padding="5 3" MinWidth="58"
                                            Background="#1D1D1D" BorderBrush="#353535" BorderThickness="1" CornerRadius="4"
                                            ToolTip="{Binding ToolTip}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <local:DeviceGlyphControl Width="34" Height="22"
                                                                      Kind="{Binding Device.Kind}"
                                                                      AccentBrush="{Binding Device.AccentBrush}"
                                                                      SlotNumber="{Binding Device.SlotNumber}"
                                                                      ShowSlotIndicator="{Binding Device.ShowSlotIndicator}">
                                                <local:DeviceGlyphControl.Style>
                                                    <Style TargetType="local:DeviceGlyphControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Device}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:DeviceGlyphControl.Style>
                                            </local:DeviceGlyphControl>
                                            <local:ControlGlyphControl Width="34" Height="22" Margin="4 0 0 0"
                                                                       Kind="{Binding ControlKind}"
                                                                       AccentBrush="{Binding ControlBrush}"
                                                                       Label="{Binding ControlLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2 0 6 0">
                        <materialDesign:PackIcon Kind="Filter"
                                                 Width="16" Height="16"
                                                 Margin="4 0 6 0"
                                                 Foreground="{StaticResource MappingTypeFilterBrush}"
                                                 ToolTip="This mapping references one or more filters">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasFilters}" Value="True"/>
                                                <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>

                        <Border Width="1" Height="22" Margin="1 0 4 0" Background="#3A3A3A"
                                ToolTip="Right-drag a collapsed card to reorder mappings"/>
                        <Button ToolTip="Rename mapping"
                                Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Rename_OnClick">
                            <materialDesign:PackIcon Kind="Edit" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Add plugin to mapping"
                                Style="{StaticResource UcrMappingActionButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="AddPlugin_OnClick">
                            <materialDesign:PackIcon Kind="LibraryAdd" Width="17" Height="17"/>
                        </Button>
                        <Button ToolTip="Remove mapping"
                                Style="{StaticResource UcrMappingDeleteButton}"
                                IsEnabled="{Binding ButtonsEnabled}" Click="Remove_OnClick">
                            <materialDesign:PackIcon Kind="Trash" Width="17" Height="17"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Expander.Header>

            <Border Margin="8 0 8 8"
                    Padding="4 6 4 4"
                    Background="#202020"
                    BorderBrush="#303030"
                    BorderThickness="1 1 1 0"
                    CornerRadius="3">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DeviceBindings}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:DeviceBindingControl DataContext="{Binding}"
                                                            DeviceBinding="{Binding DeviceBinding}"
                                                            Label="{Binding DeviceBindingName}"
                                                            Category="{Binding DeviceBindingCategory}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Plugins}" VerticalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <plugin:PluginControl Margin="0 4 0 0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Expander>
    </Border>
</UserControl>
