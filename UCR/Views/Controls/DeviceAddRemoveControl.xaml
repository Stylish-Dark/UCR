<UserControl x:Class="HidWizards.UCR.Views.Controls.DeviceAddRemoveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="580"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ShadowDeviceRow" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="BorderBrush" Value="#353535"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="7 4"/>
            <Setter Property="Padding" Value="10 8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#292929"/>
                    <Setter Property="BorderBrush" Value="#5A5A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="AvailableDevicesPanel" Grid.Column="0" Background="#191919"
                BorderBrush="#393939" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#242424" BorderBrush="#373737" BorderThickness="0 0 0 1" Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="AVAILABLE DEVICES" FontSize="11" FontWeight="SemiBold" Foreground="#E7E7E7"/>
                        <TextBlock Grid.Column="1" Text="{Binding AvailableDevices.Count}" FontSize="11" Foreground="#8E8E8E"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0 4">
                        <ItemsControl ItemsSource="{Binding AvailableDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ShadowDeviceRow}">
                                        <Grid Background="Transparent" Cursor="Hand" MouseDown="Device_OnAddDevice" ToolTip="Add this shadow device">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F4"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProviderName}" FontSize="10.5" Foreground="#929292"
                                                           Margin="0 2 0 0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Margin="10 0 0 0"
                                                    Background="#181818" BorderBrush="#444444" BorderThickness="1">
                                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"
                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableDevices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="Usb" Width="25" Height="25" Foreground="#666666" HorizontalAlignment="Center"/>
                        <TextBlock Text="No available devices" Foreground="#8C8C8C" FontSize="12" Margin="0 7 0 0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" IsHitTestVisible="False">
            <Border Width="1" Background="#343434" HorizontalAlignment="Center"/>
        </Grid>

        <Border x:Name="SelectedDevicesPanel" Grid.Column="2" Background="#191919"
                BorderBrush="#393939" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#242424" BorderBrush="#373737" BorderThickness="0 0 0 1" Padding="12 10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SHADOW DEVICES" FontSize="11" FontWeight="SemiBold" Foreground="#E7E7E7"/>
                        <TextBlock Grid.Column="1" Text="{Binding ShadowDevices.Count}" FontSize="11" Foreground="#8E8E8E"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0 4">
                        <ItemsControl ItemsSource="{Binding ShadowDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ShadowDeviceRow}">
                                        <Grid Background="Transparent" Cursor="Hand" MouseDown="Device_OnRemoveDevice" ToolTip="Remove this shadow device">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F4"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProviderName}" FontSize="10.5" Foreground="#929292"
                                                           Margin="0 2 0 0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Margin="10 0 0 0"
                                                    Background="#181818" BorderBrush="#444444" BorderThickness="1">
                                                <materialDesign:PackIcon Kind="Minus" Width="15" Height="15" Foreground="#D8D8D8"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShadowDevices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="Minus" Width="25" Height="25" Foreground="#666666" HorizontalAlignment="Center"/>
                        <TextBlock Text="No shadow devices selected" Foreground="#8C8C8C" FontSize="12" Margin="0 7 0 0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
