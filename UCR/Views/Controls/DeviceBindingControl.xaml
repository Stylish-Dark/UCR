<UserControl x:Class="HidWizards.UCR.Views.Controls.DeviceBindingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:plugin="clr-namespace:HidWizards.UCR.Views.Controls.Plugin"
             d:DesignHeight="160" d:DesignWidth="900"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <Grid Margin="4 3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="88"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 8 0">
            <TextBlock Text="{Binding DeviceBindingName}" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="{Binding IoTypeName}" Opacity="0.66" FontSize="14" Margin="0 1 0 0"/>
        </StackPanel>

        <ComboBox Grid.Row="0" Grid.Column="1"
                  Margin="0 0 8 0"
                  MinWidth="135"
                  x:Name="DeviceSelectionBox"
                  ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  IsEnabled="{Binding BindingEnabled}"
                  DisplayMemberPath="Title"
                  SelectedValuePath="Value"
                  SelectionChanged="DeviceNumberBox_OnSelected"/>

        <Grid Grid.Row="0" Grid.Column="2" MinWidth="120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Content="{Binding BindButtonText}"
                    IsEnabled="{Binding BindingEnabled}"
                    Name="BindButton"
                    Margin="0"
                    Click="BindButton_OnClick"
                    MinWidth="110"
                    materialDesign:ButtonProgressAssist.Value="{Binding PreviewValue}"
                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding ShowButtonPreview}"
                    materialDesign:TransitionAssist.DisableTransitions="True"
                    materialDesign:ShadowAssist.ShadowEdges="Left, Top, Bottom">
                <Button.ContextMenu>
                    <ContextMenu x:Name="Ddl" Style="{StaticResource MaterialDesignContextMenu}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                <Setter Property="Command" Value="{Binding MenuCommand}"/>
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="1" IsEnabled="{Binding BindingEnabled}" Margin="0"
                    Click="BindMenuButton_OnClick"
                    Width="40" Padding="0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ShadowAssist.ShadowEdges="Top, Right, Bottom">
                <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical" Margin="8 0 0 0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowBlock}" VerticalAlignment="Center" Margin="0 0 0 2">
                <TextBlock Text="Block" VerticalAlignment="Center" Margin="0 0 6 0" FontSize="14"/>
                <ToggleButton IsChecked="{Binding Block, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowInvertInput}" VerticalAlignment="Center">
                <TextBlock Text="Reverse" VerticalAlignment="Center" Margin="0 0 6 0" FontSize="14" ToolTip="Reverse this input axis direction"/>
                <ToggleButton IsChecked="{Binding InvertInput, Mode=TwoWay}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </StackPanel>
        </StackPanel>

        <plugin:PluginPropertyListControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                          Margin="0 4 0 0"
                                          DataContext="{Binding PluginPropertyGroup}"
                                          Visibility="{Binding ShowPropertyList}"/>
    </Grid>
</UserControl>
