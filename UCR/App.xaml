<Application x:Class="HidWizards.UCR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converter="clr-namespace:HidWizards.UCR.Utilities.Converter"
             xmlns:controls="clr-namespace:HidWizards.UCR.Views.Controls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose"
             Exit="App_OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Blue.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="UcrMappingGlyphButton" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#363636"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UcrBindingButton" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Background" Value="{DynamicResource UcrAccentBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UcrProfileActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                    <Setter Property="Foreground" Value="#DEDEDE"/>
                    <Setter Property="Background" Value="#282828"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Opacity" Value="0.94"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Background" Value="#343434"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </Style.Triggers>
                    </Style>
            <!-- Built-in fallbacks for replaceable device-row icon controls. -->
            <Style x:Key="DeviceRowIconButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="3 0"/>
                <Setter Property="Padding" Value="7"/>
                <Setter Property="Foreground" Value="#E3E3E3"/>
                <Setter Property="Background" Value="#303030"/>
                <Setter Property="BorderBrush" Value="#707070"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Surface" CornerRadius="4" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#454545"/>
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#A8A8A8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#123D91"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#76A7FF"/>
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.32"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeviceRowIconToggle" TargetType="{x:Type CheckBox}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Margin" Value="3 0"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Border x:Name="Surface" CornerRadius="4" Background="#303030"
                                    BorderBrush="#707070" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#123D91"/>
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#5B96F2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#B3B3B3"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#76A7FF"/>
                                    <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.32"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Built-in fallback for replaceable binding progress-bar style. -->
            <Style x:Key="UcrBindingProgressBar" TargetType="{x:Type ProgressBar}">
                <Setter Property="Background" Value="#303030"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid SnapsToDevicePixels="False" UseLayoutRounding="False">
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1"/>
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="1" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Built-in slim scrollbar fallback; editable XAML in Assets/Styles/scrollbars.xaml. -->
            <Style x:Key="UcrSlimVerticalScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                       ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinHeight="32">
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="Background" Value="#747474"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#999999"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#B0B0B0"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                      CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Built-in fallbacks for editable toolbar and group controls. -->
            <Style x:Key="UcrToolbarActionButton" TargetType="{x:Type Button}">
                    <Setter Property="Width" Value="38"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Background" Value="#292929"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="ActionSurface" CornerRadius="3"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter RecognizesAccessKey="True"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ActionSurface" Property="Background" Value="#383838"/>
                                        <Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ActionSurface" Property="Background" Value="#15469A"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ActionSurface" Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.42"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    </Style>

            <Style x:Key="UcrGroupAction" TargetType="{x:Type Button}">
                    <Setter Property="Width" Value="30"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Margin" Value="2 0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="#D5D5D5"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                    <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome" Background="#292929"
                            BorderBrush="{DynamicResource PrimaryHueLightBrush}" BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3B3B3B"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1C4A91"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#5D91DF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.36"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    </ControlTemplate>
                    </Setter.Value>
                    </Setter>
                    </Style>

            <Style x:Key="UcrGroupBlockSwitch" TargetType="{x:Type ToggleButton}">
                    <Setter Property="Width" Value="36"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                    <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="36" Height="20">
                        <Border x:Name="Track" Background="#4B4B4B"
                                BorderBrush="#777777" BorderThickness="1"
                                CornerRadius="10"/>
                        <Path x:Name="Thumb" Width="16" Height="16" Stretch="None"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="2 0 0 0" Fill="#E9E9E9"
                              UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Path.Data>
                                <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7"/>
                            </Path.Data>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2359AA"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#5895EF"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0 0 2 0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    </ControlTemplate>
                    </Setter.Value>
                    </Setter>
                    </Style>
            <!-- Built-in styles for editable compact binding buttons. -->
            <Style x:Key="CompactBindSurfaceButton" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3 0 0 3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactBindOptionsButton" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#EAEAEA"/>
                <Setter Property="Background" Value="#303030"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0 3 3 0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#414141"/>
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF"/>
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Built-in NOT toggle fallback; editable version in Assets/Styles/switches.xaml. -->
            <Style x:Key="MappingNotToggle" TargetType="{x:Type ToggleButton}">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="NotSurface" Background="#343434" CornerRadius="3"
                                        BorderBrush="#666666" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="NotSurface" Property="Background"
                                                Value="{DynamicResource PrimaryHueMidBrush}"/>
                                            <Setter TargetName="NotSurface" Property="BorderBrush"
                                                Value="{DynamicResource PrimaryHueLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NotSurface" Property="BorderBrush"
                                                Value="{DynamicResource PrimaryHueLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
            <!-- Built-in fallbacks for replaceable mapping selector and output inversion styles. -->
    <Style x:Key="DirectionalTypeChoice" TargetType="{x:Type RadioButton}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="1 0"/>
        <Setter Property="Foreground" Value="#D8D8D8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Surface" Background="#303030" CornerRadius="3"
                            BorderBrush="#565656" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#E0E0E0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="#1C1C1C"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#393939"/>
                            <Setter Property="Foreground" Value="#696969"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter Property="Opacity" Value="0.48"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="#262626"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#585858"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="UcrOutputInvertSwitch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border x:Name="Track" Background="#515151" BorderBrush="#737373"
                                BorderThickness="1" CornerRadius="11"/>
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3 0 0 0"
                                 Fill="#EAEAEA" HorizontalAlignment="Left"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource PrimaryHueLightBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource PrimaryHueLightBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#AAAAAA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
            <!-- Shared across compact single inputs and grouped directional inputs.
                 It must be application-scoped: grouped rows are outside the child
                 CompactInputBindingControl resource dictionary. -->
            <Style x:Key="CompactBlockSwitch" TargetType="{x:Type ToggleButton}">
                        <Setter Property="Width" Value="38"/>
                        <Setter Property="Height" Value="20"/>
                        <Setter Property="Background" Value="#515151"/>
                        <Setter Property="BorderBrush" Value="#737373"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                        <Border x:Name="Track" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"/>
                                        <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3 0 0 0"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#F2F2F2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="Thumb" Property="Margin" Value="0 0 3 0"/>
                                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Track" Property="BorderBrush" Value="#A0A0A0"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
            <system:Double x:Key="UcrLayoutWindowHeight">740</system:Double>
            <system:Double x:Key="UcrLayoutWindowMinHeight">500</system:Double>
            <system:Double x:Key="UcrLayoutWindowWidth">1320</system:Double>
            <system:Double x:Key="UcrLayoutWindowMinWidth">1200</system:Double>
            <system:Double x:Key="UcrUiScale">1.0</system:Double>

            <!-- Required by MappingCardControl.xaml even when an editable external
                 stylesheet fails to load. Keep this core style compiled. -->
            <Style x:Key="UcrMappingSecondaryActionButton" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="66"/>
                <Setter Property="Padding" Value="10 3"/>
                <Setter Property="Foreground" Value="#ECECEC"/>
                <Setter Property="Background" Value="#303030"/>
                <Setter Property="BorderBrush" Value="#666666"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3C3C3C"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A dedicated delete-button template avoids MaterialDesign's icon scaling/clipping.
                 Two fixed-size strokes always render a legible red X, even when disabled. -->
            <Style x:Key="UcrDeleteCrossButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="BorderBrush" Value="#606060"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="DeleteChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" SnapsToDevicePixels="True">
                                <Grid Width="22" Height="22"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Line X1="4" Y1="4" X2="18" Y2="18"
                                          Stroke="#FF6868" StrokeThickness="3.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="18" Y1="4" X2="4" Y2="18"
                                          Stroke="#FF6868" StrokeThickness="3.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteChrome" Property="Background" Value="#463030"/>
                                    <Setter TargetName="DeleteChrome" Property="BorderBrush" Value="#B85555"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="DeleteChrome" Property="Background" Value="#552D2D"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="DeleteChrome" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Individual input/output removal uses a lighter cross; full mapping
                 deletion deliberately keeps the bold UcrDeleteCrossButton. -->
            <Style x:Key="UcrDeleteItemButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="#333333"/>
                <Setter Property="BorderBrush" Value="#606060"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="DeleteChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3" SnapsToDevicePixels="True">
                                <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Close" Width="21" Height="21"
                                                             Foreground="#FF7979" HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DeleteChrome" Property="Background" Value="#463030"/>
                                    <Setter TargetName="DeleteChrome" Property="BorderBrush" Value="#B85555"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="DeleteChrome" Property="Background" Value="#552D2D"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="DeleteChrome" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Compatibility shim for older compiled templates. Current device icons use DeviceSymbolControl. -->
            <Style x:Key="DeviceSymbolText" TargetType="{x:Type TextBlock}">
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>            <DataTemplate x:Key="DeviceSymbolTemplate">
                <Grid Width="48" Height="30" ToolTip="{Binding ToolTip}">
                    <controls:DeviceSymbolControl SymbolText="{Binding SymbolText}"
                                                  Foreground="{Binding BadgeTextBrush}"
                                                  GlyphSize="29"
                                                  Width="48" Height="30">
                        <controls:DeviceSymbolControl.Style>
                            <Style TargetType="{x:Type controls:DeviceSymbolControl}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSymbol}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:DeviceSymbolControl.Style>
                    </controls:DeviceSymbolControl>
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                             Foreground="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="{x:Type materialDesign:PackIcon}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSymbol}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Grid>
            </DataTemplate>
<!-- Custom UCR palette -->
            <SolidColorBrush x:Key="MaterialDesignBackground" Color="#212121"/>
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#212121"/>
            <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#212121"/>
            <SolidColorBrush x:Key="MaterialDesignToolBarBackground" Color="#212121"/>
            <SolidColorBrush x:Key="MaterialDesignSelection" Color="#0030A8"/>
            <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="#0038C3"/>
            <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#0030A8"/>
            <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#00278A"/>
            <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#0030A8"/>
            <SolidColorBrush x:Key="UcrAccentBrush" Color="#0030A8"/>
            <SolidColorBrush x:Key="SecondaryAccentForegroundBrush" Color="#FFFFFF"/>

            <!-- Explicit dark surfaces so dialogs never fall back to system/light control colours. -->
            <SolidColorBrush x:Key="UcrDialogBackgroundBrush" Color="#212121"/>
            <SolidColorBrush x:Key="UcrDialogSurfaceBrush" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="UcrDialogForegroundBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="UcrSecondaryTextBrush" Color="#D0D0D0"/>

            <!-- Mapping endpoint colours. Keep these centralized so headers and selectors stay consistent. -->
            <SolidColorBrush x:Key="MappingTypeButtonBrush" Color="#0058B8"/>
            <SolidColorBrush x:Key="MappingTypeAxisBrush" Color="#9C7800"/>
            <SolidColorBrush x:Key="MappingTypeFilterBrush" Color="#00A82A"/>
            <SolidColorBrush x:Key="MappingTypeEventBrush" Color="#900000"/>
            <SolidColorBrush x:Key="MappingTypeDeltaBrush" Color="#A03000"/>
            <SolidColorBrush x:Key="MappingTypeValueBrush" Color="#520098"/>
            <SolidColorBrush x:Key="MappingTypeNoneBrush" Color="#707070"/>
            <converter:MappingTypeBrushConverter x:Key="MappingTypeBrushConverter"/>

            <Style x:Key="UcrDialogRoot" TargetType="{x:Type UserControl}">
                <Setter Property="Background" Value="{DynamicResource UcrDialogBackgroundBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource UcrDialogForegroundBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
                <Setter Property="FocusManager.IsFocusScope" Value="True"/>
            </Style>

            <!-- Unstyled buttons must still read as interactive controls. Explicit
                 specialised styles may override these defaults, but cannot silently
                 turn ordinary actions into bare text. -->
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#292929"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Accent colour belongs to selected surfaces, not ordinary text. -->
            <Style x:Key="UcrAccentOutlineButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="#272727"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="UcrDialogFlatButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="UcrDialogRaisedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>
            <Style TargetType="{x:Type Hyperlink}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Style>

            <Style x:Key="UcrNavigationBackButton" TargetType="{x:Type Button}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="30"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#303030"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#303030"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border Margin="-2" BorderBrush="#FFFFFF" BorderThickness="1"
                                    CornerRadius="2" SnapsToDevicePixels="True"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Device badge-text picker visuals are created only after the user clicks a row's colour button.
                 Keeping the picker out of Application resources prevents a picker/template failure from
                 preventing the Devices ListView from materialising its rows. -->

            <Style TargetType="{x:Type Window}" >
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome
                            CaptionHeight="0"
                            CornerRadius="5"
                            GlassFrameThickness="0"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="WindowState" Value="Maximized">
                        <Setter Property="BorderThickness" Value="8" />
                    </Trigger>
                    <Trigger Property="WindowState" Value="Normal">
                        <Setter Property="BorderThickness" Value="20" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <SolidColorBrush x:Key="Red" Color="#FFB00000"/>
            <Style x:Key="MaterialDesignCardButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignToolButton}">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Background" Value="#292929"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="MaterialDesignGroupBoxButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignToolButton}">
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="4 2"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style x:Key="MaterialDesignFlatBarButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="0"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <materialDesign:Ripple Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Focusable="False"    
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}" 
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Button.IsDefaulted" Value="true">
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource MaterialDesignFlatButtonClick}" />
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource MaterialDesignFlatButtonClick}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.23"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MaterialDesignFlatRedBarButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueDarkForegroundBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ButtonBase}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="0"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <materialDesign:Ripple Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Focusable="False"    
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}" 
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Button.IsDefaulted" Value="true">
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Red}" />
                                    <Setter Property="Background" TargetName="border" Value="{DynamicResource Red}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Opacity" Value="0.23"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Built-in fallback for profile device selector buttons. -->
            <Style x:Key="PrimaryDeviceButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Built-in fallbacks for replaceable mapping and device page buttons. -->
            <Style x:Key="UcrMappingActionButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource MaterialDesignCardButton}">
                    <Setter Property="Foreground" Value="#DADADA"/>
                    <Setter Property="Opacity" Value="0.84"/>
                    <Setter Property="Margin" Value="2"/>
                    <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                    </Style.Triggers>
                    </Style>

            <Style x:Key="DevicePageTextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource UcrDialogFlatButton}">
                    <Setter Property="Background" Value="#303030"/>
                    <Setter Property="BorderBrush" Value="#686868"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="10 6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#414141"/>
                        <Setter Property="BorderBrush" Value="#A0A0A0"/>
                    </Trigger>
                    </Style.Triggers>
                    </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
