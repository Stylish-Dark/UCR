<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="UcrDialogRoot" TargetType="{x:Type UserControl}">
    <Setter Property="Background" Value="{DynamicResource UcrDialogBackgroundBrush}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource UcrDialogForegroundBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
    <Setter Property="FocusManager.IsFocusScope" Value="True"/>
                </Style>
</ResourceDictionary>
