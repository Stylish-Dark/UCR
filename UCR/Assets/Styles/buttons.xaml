<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Style x:Key="UcrDeleteCrossButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#606060"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="DeleteChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid Width="22" Height="22"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Line X1="4" Y1="4" X2="18" Y2="18"
                                  Stroke="#FF6868" StrokeThickness="3.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="18" Y1="4" X2="4" Y2="18"
                                  Stroke="#FF6868" StrokeThickness="3.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DeleteChrome" Property="Background" Value="#463030"/>
                            <Setter TargetName="DeleteChrome" Property="BorderBrush" Value="#B85555"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DeleteChrome" Property="Background" Value="#552D2D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DeleteChrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UcrDeleteItemButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#606060"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="DeleteChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Close" Width="21" Height="21"
                                                     Foreground="#FF7979" HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DeleteChrome" Property="Background" Value="#463030"/>
                            <Setter TargetName="DeleteChrome" Property="BorderBrush" Value="#B85555"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DeleteChrome" Property="Background" Value="#552D2D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DeleteChrome" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
