<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Edit controls by their x:Name; no change to window behavior or event handlers. -->
    <Style x:Key="UiWindowIcon" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="4"/>
    </Style>
    <Style x:Key="UiWindowTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="4 8"/>
    </Style>
    <Style x:Key="UiWindowClose" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    <Style x:Key="UiWindowMaximize" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    <Style x:Key="UiWindowMinimize" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="32"/>
    </Style>
</ResourceDictionary>
