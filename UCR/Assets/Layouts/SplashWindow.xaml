<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RootBorder" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="22"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PhaseText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="DetailText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="ProgressIndicator" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>
