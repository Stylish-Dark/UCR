<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="UiPrimaryDevice" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0 0 2 0"/>
    </Style>

    <Style x:Key="UiRemoveDevice" TargetType="{x:Type Button}"></Style>

    <Style x:Key="UiConfigureDevice" TargetType="{x:Type Button}"></Style>

    <Style x:Key="UiAddDevice" TargetType="{x:Type Button}"></Style>

    <Style x:Key="DeviceList" TargetType="{x:Type ListView}">
        <Setter Property="Margin" Value="8 4 8 8"/>
    </Style>
</ResourceDictionary>
