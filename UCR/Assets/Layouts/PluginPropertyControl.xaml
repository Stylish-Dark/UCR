<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add intentional overrides here; default label wrapping and spacing belong to the shared view. -->
    <Style x:Key="UiPropertyRow" TargetType="{x:Type Grid}"/>
    <Style x:Key="UiPropertyName" TargetType="{x:Type TextBlock}"/>
    <Style x:Key="UiPropertyValue" TargetType="{x:Type ContentPresenter}"/>
    <Style x:Key="PluginPropertyControlName" TargetType="{x:Type UserControl}"/>
</ResourceDictionary>
