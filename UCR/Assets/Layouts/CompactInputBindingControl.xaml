<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Only runtime differences belong here; identical compiled values stay in the view. -->
    <Style x:Key="BindingActionGroup" TargetType="{x:Type Grid}">
        <Setter Property="MaxWidth" Value="1600"/>
    </Style>
    <Style x:Key="BindSurface" TargetType="{x:Type Grid}">
        <Setter Property="MinHeight" Value="38"/>
    </Style>
</ResourceDictionary>
