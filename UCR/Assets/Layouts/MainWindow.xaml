<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rules target existing x:Name elements in MainWindow. Properties can be changed without rebuilding. -->
    <Style x:Key="MainToolbarHost" TargetType="{x:Type Grid}">
        <Setter Property="Grid.Row" Value="1"/>
    </Style>

    <Style x:Key="WorkspaceTabs" TargetType="{x:Type TabControl}">
        <Setter Property="Margin" Value="2 0 0 0"/>
    </Style>

    <Style x:Key="ProfileDeviceEditorHost" TargetType="{x:Type ContentControl}">
        <Setter Property="MaxHeight" Value="280"/>
    </Style>
</ResourceDictionary>
