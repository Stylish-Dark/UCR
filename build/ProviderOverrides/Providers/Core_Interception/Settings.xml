<?xml version="1.0" encoding="utf-8" ?>
<Settings>
  <Setting>
    <!-- Stylish Edition intentionally enables Interception's per-binding Block option.
         Physical input is only suppressed when a UCR binding explicitly has Block enabled. -->
    <Name>BlockingEnabled</Name>
    <Value>true</Value>
  </Setting>
  <Setting>
    <Name>PollRate</Name>
    <Value>10</Value>
  </Setting>
  <Setting>
    <Name>StrokeOnThread</Name>
    <Value>false</Value>
  </Setting>
</Settings>
