+        private void CaptureInitialAxes(Joystick joystick)
+        {
+            _axisValues.Clear();
+            try
+            {
+                joystick.Poll();
+                var state = joystick.GetCurrentState();
+                foreach (var axis in joystick.GetObjects(DeviceObjectTypeFlags.AbsoluteAxis))
+                {
+                    switch ((JoystickOffset)axis.Offset)
+                    {
+                        case JoystickOffset.X: RememberAxis(JoystickOffset.X, state.X); break;
+                        case JoystickOffset.Y: RememberAxis(JoystickOffset.Y, state.Y); break;
+                        case JoystickOffset.Z: RememberAxis(JoystickOffset.Z, state.Z); break;
+                        case JoystickOffset.RotationX: RememberAxis(JoystickOffset.RotationX, state.RotationX); break;
+                        case JoystickOffset.RotationY: RememberAxis(JoystickOffset.RotationY, state.RotationY); break;
+                        case JoystickOffset.RotationZ: RememberAxis(JoystickOffset.RotationZ, state.RotationZ); break;
+                        case JoystickOffset.Sliders0: RememberAxis(JoystickOffset.Sliders0, state.Sliders[0]); break;
+                        case JoystickOffset.Sliders1: RememberAxis(JoystickOffset.Sliders1, state.Sliders[1]); break;
+                    }
+                }
+            }
+            catch (SharpDX.SharpDXException exception)
+            {
+                // A snapshot is optional. Buffered subscriptions still work on devices that reject it.
+                _logger.Log($"Unable to snapshot axes for {DeviceDescriptor}: {exception.Message}");
+            }
+        }
+
+        private void RememberAxis(JoystickOffset offset, int raw)
+        {
+            _axisValues[(int)offset] = (short)_axisProcessor.UnsignedToSigned(raw);
+        }
